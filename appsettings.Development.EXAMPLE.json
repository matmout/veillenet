{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "REPLACE_WITH_YOUR_DEV_DATABASE_CONNECTION_STRING",
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 30
  },
  "EmailSettings": {
    "SourceEmail": "your-dev-email@example.com",
    "AwsAccessKey": "REPLACE_WITH_YOUR_AWS_ACCESS_KEY",
    "AwsSecretKey": "REPLACE_WITH_YOUR_AWS_SECRET_KEY",
    "AwsRegion": "eu-west-3"
  },
  "Reddit": {
    "Enabled": true,
    "CacheMinutes": 60,
    "PostsPerSubreddit": 10
  }
}
