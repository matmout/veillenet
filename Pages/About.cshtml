@page
@model VeilleNet.Pages.AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "Learn more about ContainSharp, the technology watch dashboard for C# and .NET developers.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/About";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "person-circle" },
        { "HeaderTitle", "About" },
        { "HeaderDescription", "Who built ContainSharp and why." },
        { "HeaderTokenColor", "function" }
    })' />

    <section class="about-grid">
        <div class="about-photo-wrap">
            <img class="about-photo"
                 src="~/images/about.jpg"
                 alt="Matthieu TRACHSEL"
                 loading="lazy"
                 decoding="async" />
        </div>

        <article class="content-card" data-token="function">
            <h2 class="content-card-title">
                <i class="bi bi-terminal"></i> matthieu_trachsel.bio
            </h2>
            <p>
                This site is built with C# .NET 10 and Razor Pages. I created it to stay current as a developer —
                aggregating resources, testing ideas, and practising on real features. The brief was simple: a Visual
                Studio-inspired surface that doubles as a daily reading habit and a playground.
            </p>
            <p>
                As a developer, I needed a central place to track news, prototype ideas, and keep learning.
                ContainSharp structures that loop for me, one briefing at a time.
            </p>
            <p>
                I am currently a FullStack Developer at BRED, based in Paris. Always curious about challenging
                projects and collaborative environments that push technical craftsmanship forward.
            </p>
        </article>
    </section>

    <section class="about-links">
        <article class="content-card" data-token="function">
            <h2 class="content-card-title">
                <i class="bi bi-linkedin"></i> linkedin
            </h2>
            <p>Connect and follow professional updates.</p>
            <div class="content-card-actions">
                <a class="output-action" href="https://fr.linkedin.com/in/matthieu-trachsel-863a1249/enw" target="_blank" rel="noopener">
                    <i class="bi bi-box-arrow-up-right"></i> View profile
                </a>
            </div>
        </article>

        <article class="content-card" data-token="function">
            <h2 class="content-card-title">
                <i class="bi bi-github"></i> github
            </h2>
            <p>Explore repositories and contributions.</p>
            <div class="content-card-actions">
                <a class="output-action" href="https://github.com/matmout" target="_blank" rel="noopener">
                    <i class="bi bi-box-arrow-up-right"></i> View profile
                </a>
            </div>
        </article>
    </section>
</div>

@section Styles {
    <style>
        .about-grid {
            display: grid;
            grid-template-columns: minmax(220px, 320px) 1fr;
            gap: var(--space-5);
            align-items: stretch;
        }

        .about-photo-wrap {
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: var(--space-3);
            background: var(--panel);
            overflow: hidden;
        }

        .about-photo {
            width: 100%;
            height: 100%;
            min-height: 280px;
            object-fit: cover;
            border-radius: var(--radius);
            display: block;
        }

        .about-links {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-4);
        }

        @@media (max-width: 768px) {
            .about-grid,
            .about-links {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
