@page
@model NewsletterModel
@{
    ViewData["Title"] = "Newsletter Unsubscribe - ContainSharp";
    ViewData["Description"] = "Manage your ContainSharp newsletter subscription. Unsubscribe from daily C# and .NET developer news updates.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/Newsletter";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="vs-panel">
                <div class="vs-panel-header">
                    <i class="bi bi-envelope-dash"></i> Unsubscribe from Newsletter
                </div>
                
                <div class="vs-panel-body">
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        var alertClass = Model.MessageType switch
                        {
                            "success" => "vs-alert-success",
                            "error" => "vs-alert-error",
                            "info" => "vs-alert-info",
                            _ => "vs-alert-secondary"
                        };

                        var icon = Model.MessageType switch
                        {
                            "success" => "bi-check-circle",
                            "error" => "bi-exclamation-triangle",
                            "info" => "bi-info-circle",
                            _ => "bi-bell"
                        };

                        <div class="vs-alert @alertClass">
                            <i class="bi @icon"></i> 
                            @Model.Message
                        </div>
                    }

                    <div class="vs-info-box">
                        <div class="vs-info-box-title">
                            <i class="bi bi-shield-lock"></i> Secure 2-Step Process
                        </div>
                        <ol class="vs-info-list">
                            <li>Enter your email and click "Request Unsubscription"</li>
                            <li>You will receive an email with a confirmation link</li>
                            <li>Click the link to finalize your unsubscription</li>
                        </ol>
                        <p class="vs-info-note">This process ensures that no one else can unsubscribe you without your consent.</p>
                    </div>

                    <form method="post" asp-page-handler="RequestUnsubscribe">
                        <div class="vs-form-group">
                            <label for="unsubscribe-email" class="vs-label">
                                <i class="bi bi-envelope"></i> Email Address
                            </label>
                            <input type="email" 
                                   class="vs-input" 
                                   id="unsubscribe-email" 
                                   name="Email"
                                   asp-for="Email"
                                   placeholder="your.email@example.com" 
                                   required>
                            <span asp-validation-for="Email" class="vs-error"></span>
                        </div>

                        <div class="vs-form-actions">
                            <button type="submit" class="vs-button vs-button-danger">
                                <i class="bi bi-envelope-x"></i> Request Unsubscription
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="vs-panel vs-panel-secondary mt-4">
                <div class="vs-panel-header">
                    <i class="bi bi-info-circle"></i> About the Unsubscription Process
                </div>
                <div class="vs-panel-body">
                    <ul class="vs-feature-list">
                        <li>
                            <i class="bi bi-lock-fill text-success"></i>
                            <div>
                                <strong>Secure</strong>
                                <span>2-step verification prevents unauthorized unsubscriptions</span>
                            </div>
                        </li>
                        <li>
                            <i class="bi bi-clock-fill text-info"></i>
                            <div>
                                <strong>Valid for 24 hours</strong>
                                <span>Confirmation link expires after 24 hours</span>
                            </div>
                        </li>
                        <li>
                            <i class="bi bi-arrow-counterclockwise text-warning"></i>
                            <div>
                                <strong>Reversible</strong>
                                <span>Simply ignore the email to stay subscribed</span>
                            </div>
                        </li>
                        <li>
                            <i class="bi bi-shield-check text-primary"></i>
                            <div>
                                <strong>Privacy Protected</strong>
                                <span>Your email is never shared with third parties</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

