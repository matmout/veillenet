@page
@model NewsletterModel
@{
    ViewData["Title"] = "Unsubscribe";
    ViewData["Description"] = "Unsubscribe from ContainSharp newsletter.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/Newsletter";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "envelope-dash" },
        { "HeaderTitle", "Unsubscribe" },
        { "HeaderDescription", "Two-step opt-out from the daily briefing." },
        { "HeaderTokenColor", "string" }
    })' />

    <section class="newsletter-grid">
        <article class="content-card" data-token="string">
            <h2 class="content-card-title">
                <i class="bi bi-envelope-x"></i> request_unsubscription
            </h2>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                var alertClass = Model.MessageType switch
                {
                    "success" => "vs-alert-success",
                    "error"   => "vs-alert-error",
                    "info"    => "vs-alert-info",
                    _         => "vs-alert-secondary"
                };

                var alertIcon = Model.MessageType switch
                {
                    "success" => "bi-check-circle",
                    "error"   => "bi-exclamation-triangle",
                    "info"    => "bi-info-circle",
                    _         => "bi-bell"
                };

                <div class="vs-alert @alertClass" role="alert">
                    <i class="bi @alertIcon" aria-hidden="true"></i>
                    <span>@Model.Message</span>
                </div>
            }

            <form method="post" asp-page-handler="RequestUnsubscribe" class="newsletter-form">
                <label for="unsubscribe-email" class="filter-bar-label">
                    <i class="bi bi-envelope" aria-hidden="true"></i> Email address
                </label>
                <input id="unsubscribe-email"
                       type="email"
                       class="briefing-cta-input"
                       name="Email"
                       asp-for="Email"
                       placeholder="your.email@example.com"
                       required />
                <span asp-validation-for="Email" class="vs-error"></span>

                <div class="content-card-actions">
                    <button type="submit" class="briefing-cta-submit" data-variant="danger">
                        <i class="bi bi-envelope-x"></i> Request unsubscription
                    </button>
                </div>
            </form>
        </article>

        <article class="content-card" data-token="comment">
            <h2 class="content-card-title">
                <i class="bi bi-info-circle"></i> how_it_works
            </h2>
            <ol class="newsletter-steps">
                <li>Enter your email and click <strong>Request unsubscription</strong>.</li>
                <li>You will receive an email with a single-use confirmation link.</li>
                <li>Click the link within 24 hours to finalise the unsubscription.</li>
            </ol>

            <ul class="newsletter-traits">
                <li>
                    <i class="bi bi-lock-fill" aria-hidden="true"></i>
                    <div>
                        <strong>Secure</strong>
                        <span>Two-step verification prevents unauthorised unsubscriptions.</span>
                    </div>
                </li>
                <li>
                    <i class="bi bi-clock-fill" aria-hidden="true"></i>
                    <div>
                        <strong>Time-bound</strong>
                        <span>Confirmation links expire after 24 hours.</span>
                    </div>
                </li>
                <li>
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                    <div>
                        <strong>Reversible</strong>
                        <span>Ignore the email and you stay subscribed.</span>
                    </div>
                </li>
                <li>
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <div>
                        <strong>Privacy-protected</strong>
                        <span>Your email is never shared with third parties.</span>
                    </div>
                </li>
            </ul>
        </article>
    </section>
</div>

@section Styles {
    <style>
        .newsletter-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: var(--space-4);
            align-items: start;
        }

        .newsletter-form {
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
        }

        .newsletter-steps {
            margin: 0 0 var(--space-4);
            padding-left: 1.25rem;
            color: var(--text-soft);
            line-height: 1.7;
        }
        .newsletter-steps li + li { margin-top: var(--space-2); }

        .newsletter-traits {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
        }
        .newsletter-traits li {
            display: grid;
            grid-template-columns: 1.5rem 1fr;
            gap: var(--space-3);
            align-items: start;
        }
        .newsletter-traits li > i {
            color: var(--token-string);
            font-size: 1rem;
            line-height: 1.5;
        }
        .newsletter-traits li > div {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }
        .newsletter-traits strong {
            color: var(--text);
            font-weight: 600;
        }
        .newsletter-traits span {
            color: var(--text-muted);
            font-size: var(--text-sm);
            line-height: 1.5;
        }

        .briefing-cta-submit[data-variant="danger"] {
            border-color: var(--token-preprocessor);
            color: var(--token-preprocessor);
        }
        .briefing-cta-submit[data-variant="danger"]:hover {
            background: color-mix(in oklab, var(--token-preprocessor) 14%, transparent);
        }

        @@media (max-width: 992px) {
            .newsletter-grid { grid-template-columns: 1fr; }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
