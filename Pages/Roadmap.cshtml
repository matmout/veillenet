@page
@model VeilleNet.Pages.RoadmapModel
@{
    ViewData["Title"] = "C# Learning Roadmap";
    ViewData["Description"] = "Step-by-step guide to learning C# and .NET development - from fundamentals to advanced topics";
    ViewData["CanonicalUrl"] = "https://containsharp.com/Roadmap";

    var sortedPath = Model.LearningPath.OrderBy(x => x.Step).ToList();
    var foundationCount = sortedPath.Count(x => x.Type == VeilleNet.Models.RoadmapItemType.Foundation);
    var advancedCount = sortedPath.Count(x => x.Type == VeilleNet.Models.RoadmapItemType.Advanced);
    var specializationCount = sortedPath.Count(x => x.Type == VeilleNet.Models.RoadmapItemType.Specialization);
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "signpost-2" },
        { "HeaderTitle", "C# Learning Roadmap" },
        { "HeaderDescription", "Step-by-step guide to becoming a C# developer." },
        { "HeaderTokenColor", "number" }
    })' />

    <section class="roadmap-stats">
        <div class="stat-card" data-tone="keyword">
            <i class="bi bi-signpost-split stat-icon" aria-hidden="true"></i>
            <div class="stat-value">@sortedPath.Count</div>
            <div class="stat-label">Steps</div>
        </div>
        <div class="stat-card" data-tone="string">
            <i class="bi bi-star stat-icon" aria-hidden="true"></i>
            <div class="stat-value">@foundationCount</div>
            <div class="stat-label">Foundation</div>
        </div>
        <div class="stat-card" data-tone="type">
            <i class="bi bi-rocket stat-icon" aria-hidden="true"></i>
            <div class="stat-value">@advancedCount</div>
            <div class="stat-label">Advanced</div>
        </div>
        <div class="stat-card" data-tone="function">
            <i class="bi bi-trophy stat-icon" aria-hidden="true"></i>
            <div class="stat-value">@specializationCount</div>
            <div class="stat-label">Specialization</div>
        </div>
    </section>

    <section class="roadmap-grid">
        @foreach (var item in sortedPath)
        {
            var token = item.Type switch
            {
                VeilleNet.Models.RoadmapItemType.Foundation     => "string",
                VeilleNet.Models.RoadmapItemType.Advanced       => "type",
                VeilleNet.Models.RoadmapItemType.Specialization => "function",
                _ => "keyword"
            };

            <article class="content-card roadmap-card" data-token="@token">
                <header class="roadmap-card-head">
                    <span class="step-badge tabular-nums">@item.Step</span>
                    <div>
                        <h3 class="roadmap-title">
                            <i class="bi bi-@GetIcon(item.Category)" aria-hidden="true"></i>
                            @item.Title
                        </h3>
                        <p class="roadmap-description">@item.Description</p>
                        @if (item.Prerequisites.Any())
                        {
                            <p class="roadmap-prereq">
                                <i class="bi bi-arrow-return-right" aria-hidden="true"></i>
                                Prerequisites: @string.Join(", ", item.Prerequisites.Select(p => $"Step {p}"))
                            </p>
                        }
                    </div>
                </header>

                @if (item.Children.Any())
                {
                    <ul class="roadmap-children">
                        @foreach (var child in item.Children)
                        {
                            <li class="roadmap-child" data-token="@child.Type.ToString().ToLower()">
                                <span class="roadmap-badge" aria-hidden="true"></span>
                                <div>
                                    <span class="roadmap-child-title">@child.Title</span>
                                    <span class="roadmap-child-desc">@child.Description</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </article>
        }
    </section>

    <article class="content-card training-cta-card" data-token="function">
        <span class="content-card-title">
            <i class="bi bi-mortarboard"></i> test_your_knowledge
        </span>
        <h2>Ready to challenge yourself?</h2>
        <p>Try the C# quiz to assess where your skills stand.</p>
        <div class="content-card-actions">
            <a class="output-action" asp-page="/Training">
                Start the quiz <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </article>
</div>

@section Styles {
    <style>
        .roadmap-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: var(--space-3);
        }
        .roadmap-stats .stat-card {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
            padding: var(--space-4);
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            position: relative;
            overflow: hidden;
        }
        .roadmap-stats .stat-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 2px;
            background: var(--panel-token, var(--token-keyword));
            opacity: 0.85;
        }
        .stat-card[data-tone="keyword"]  { --panel-token: var(--token-keyword); }
        .stat-card[data-tone="string"]   { --panel-token: var(--token-string); }
        .stat-card[data-tone="type"]     { --panel-token: var(--token-type); }
        .stat-card[data-tone="function"] { --panel-token: var(--token-function); }

        .roadmap-stats .stat-icon { color: var(--panel-token); font-size: 1.2rem; }
        .roadmap-stats .stat-value {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1;
        }
        .roadmap-stats .stat-label {
            font-family: var(--font-mono);
            font-size: var(--text-xs);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .roadmap-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
            gap: var(--space-4);
        }

        .roadmap-card { display: flex; flex-direction: column; gap: var(--space-3); }

        .roadmap-card-head {
            display: grid;
            grid-template-columns: 36px 1fr;
            gap: var(--space-3);
            align-items: start;
        }

        .step-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: color-mix(in oklab, var(--panel-token) 18%, transparent);
            border: 1px solid var(--panel-token);
            color: var(--panel-token);
            border-radius: var(--radius);
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 0.95rem;
        }

        .roadmap-title {
            margin: 0;
            font-family: var(--font-ui);
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .roadmap-title i { color: var(--panel-token); }

        .roadmap-description {
            margin: 0.35rem 0 0;
            color: var(--text-soft);
            font-size: var(--text-sm);
            line-height: 1.55;
        }

        .roadmap-prereq {
            margin: 0.35rem 0 0;
            font-family: var(--font-mono);
            font-size: var(--text-xs);
            color: var(--text-muted);
        }

        .roadmap-children {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
        }

        .roadmap-child {
            display: grid;
            grid-template-columns: 12px 1fr;
            gap: var(--space-3);
            align-items: start;
            padding: var(--space-3);
            background: var(--panel-alt);
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        .roadmap-child[data-token="foundation"]      { --panel-token: var(--token-string); }
        .roadmap-child[data-token="advanced"]        { --panel-token: var(--token-type); }
        .roadmap-child[data-token="specialization"]  { --panel-token: var(--token-function); }

        .roadmap-badge {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-top: 0.4rem;
            background: var(--panel-token, var(--text-muted));
        }

        .roadmap-child > div { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
        .roadmap-child-title {
            font-family: var(--font-ui);
            font-weight: 600;
            color: var(--text);
            font-size: 0.95rem;
        }
        .roadmap-child-desc {
            font-family: var(--font-ui);
            font-size: var(--text-sm);
            color: var(--text-muted);
            line-height: 1.5;
        }

        .training-cta-card {
            text-align: left;
        }
    </style>
}

@functions {
    string GetIcon(string category)
    {
        return category switch
        {
            "Foundation" => "star-fill",
            "Core" => "gear-fill",
            "Advanced" => "rocket-fill",
            "Specialization" => "trophy-fill",
            _ => "circle-fill"
        };
    }
}
