@page
@model VeilleNet.Pages.AiSummaryModel
@{
    ViewData["Title"] = "AI Summary";
    ViewData["Description"] = "AI-generated summaries of the latest articles.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/AiSummary";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "stars" },
        { "HeaderTitle", "AI Summary" },
        { "HeaderDescription", "Résumés générés par IA à partir des articles des sources officielles." },
        { "HeaderTokenColor", "type" }
    })' />

    @if (Model.Summaries.Any())
    {
        <ol class="timeline-list">
            @foreach (var item in Model.Summaries.OrderByDescending(s => s.PublishedDate))
            {
                <li class="timeline-item">
                    <span class="timeline-date">
                        @item.PublishedDate.ToString("dd MMM yyyy",
                            new System.Globalization.CultureInfo("en-US"))
                    </span>
                    <div class="timeline-content">
                        <h3 class="timeline-title">
                            <a href="@item.Url" target="_blank" rel="noopener noreferrer">@item.Title</a>
                        </h3>
                        <div class="ai-summary-body">
                            @Html.Raw(VeilleNet.Services.HtmlOutputSanitizer.Sanitize(item.Summary))
                        </div>
                    </div>
                    <span class="timeline-chip" data-token="type">
                        <i class="bi bi-tag"></i> @item.Source
                    </span>
                </li>
            }
        </ol>
    }
    else
    {
        <article class="content-card" data-token="comment">
            <h2 class="content-card-title">
                <i class="bi bi-hourglass-split"></i> loading
            </h2>
            <p>Loading summaries…</p>
        </article>
    }
</div>

@section Styles {
    <style>
        .ai-summary-body {
            font-family: var(--font-ui);
            font-size: var(--text-sm);
            color: var(--text-soft);
            line-height: 1.65;
            white-space: pre-wrap;
        }
        .ai-summary-body p:last-child { margin-bottom: 0; }
    </style>
}
