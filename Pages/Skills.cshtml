@page
@model SkillsModel
@{
    ViewData["Title"] = "Curated AI Skills";
    ViewData["Description"] = "A curated April 2026 guide to high-frequency AI skill patterns, how skills work, and the file architectures used across Claude Code, OpenAI Agents, LangGraph, and Microsoft Skills.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/Skills";
}

@section Styles {
    <link rel="stylesheet" href="~/css/skills.css" asp-append-version="true" />
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "lightning-charge" },
        { "HeaderTitle", "Curated AI Skills" },
        { "HeaderDescription", "High-frequency skill patterns, packaging models, and refresh sources that still matter in April 2026" },
        { "HeaderTokenColor", "type" }
    })' />

    <div class="row g-4 mb-4">
        <div class="col-xl-7">
            <div class="card detail-card h-100">
                <div class="card-header">
                    <h2 class="h4 mb-0"><i class="bi bi-diagram-3"></i> How a skill works</h2>
                </div>
                <div class="card-body">
                    <div class="lifecycle-grid">
                        @foreach (var step in Model.PageData.Lifecycle)
                        {
                            <div class="lifecycle-step">
                                <div class="lifecycle-icon">
                                    <i class="bi bi-@step.Icon"></i>
                                </div>
                                <div>
                                    <h3 class="lifecycle-title">@step.Title</h3>
                                    <p class="lifecycle-text">@step.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-5">
            <div class="card detail-card h-100">
                <div class="card-header">
                    <h2 class="h4 mb-0"><i class="bi bi-arrow-repeat"></i> @Model.PageData.RefreshWorkflow.Title</h2>
                </div>
                <div class="card-body">
                    <p class="detail-text">@Model.PageData.RefreshWorkflow.Description</p>
                    <div class="refresh-cadence">
                        <span class="refresh-label">Cadence</span>
                        <span class="refresh-value">@Model.PageData.RefreshWorkflow.Cadence</span>
                    </div>

                    <h3 class="detail-subtitle">What triggers a refresh</h3>
                    <ul class="detail-list">
                        @foreach (var signal in Model.PageData.RefreshWorkflow.Signals)
                        {
                            <li>@signal</li>
                        }
                    </ul>

                    <h3 class="detail-subtitle">Source of truth</h3>
                    <div class="source-list">
                        @foreach (var source in Model.PageData.RefreshWorkflow.Sources)
                        {
                            <a href="@source.Url" target="_blank" rel="noopener noreferrer" class="source-link">
                                <span>@source.Name</span>
                                <span class="source-type">@source.SourceType</span>
                            </a>
                        }
                    </div>

                    <h3 class="detail-subtitle">Refresh checklist</h3>
                    <ol class="detail-list ordered-list">
                        @foreach (var step in Model.PageData.RefreshWorkflow.Steps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="section-intro mb-4">
        <h2 class="h3 mb-2"><i class="bi bi-folder2-open"></i> Typical file architecture</h2>
        <p class="mb-0">@Model.PageData.ArchitectureNote</p>
    </div>

    <div class="row g-4 mb-5">
        @foreach (var architecture in Model.PageData.Architectures)
        {
            <div class="col-lg-6">
                <div class="card architecture-card h-100">
                    <div class="card-header">
                        <div class="architecture-header">
                            <div>
                                <h3 class="h5 mb-1">@architecture.Ecosystem</h3>
                                <p class="architecture-description mb-0">@architecture.Description</p>
                            </div>
                            <span class="architecture-badge">@architecture.PackagingStyle</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="file-pill-row">
                            @foreach (var file in architecture.TypicalFiles)
                            {
                                <span class="file-pill">@file</span>
                            }
                        </div>

                        <pre class="skill-tree">@architecture.FileTree</pre>
                        <p class="architecture-notes">@architecture.Notes</p>

                        <div class="architecture-links">
                            <a href="@architecture.OfficialUrl" target="_blank" rel="noopener noreferrer" class="tool-link">
                                <i class="bi bi-book"></i> Official docs
                            </a>
                            @if (!string.IsNullOrWhiteSpace(architecture.RepositoryUrl))
                            {
                                <a href="@architecture.RepositoryUrl" target="_blank" rel="noopener noreferrer" class="tool-link secondary-link">
                                    <i class="bi bi-github"></i> Reference repo
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        @foreach (var category in Model.PageData.Categories)
        {
            <div class="col-12 mb-4">
                <div class="card h-100 category-card">
                    <div class="card-header bg-@category.ColorClass">
                        <div class="category-header-content">
                            <div>
                                <h2 class="h4 mb-0">
                                    <i class="bi @category.Icon"></i> @category.Name
                                </h2>
                                <p class="category-description mb-0 mt-2 small">@category.Description</p>
                            </div>
                            <span class="category-count">@category.Skills.Count pattern@(category.Skills.Count > 1 ? "s" : "")</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="skills-grid">
                            @foreach (var skill in category.Skills)
                            {
                                <div class="skill-card">
                                    <div class="tool-icon-wrapper">
                                        <i class="bi @skill.Icon tool-icon"></i>
                                    </div>
                                    <div class="tool-content">
                                        <div class="tool-meta">
                                            <span class="badge-trust">@skill.Ecosystem</span>
                                            <span class="badge-access">@skill.PackagingStyle</span>
                                        </div>
                                        <h3 class="tool-name">@skill.Name</h3>
                                        <p class="tool-description">@skill.Description</p>
                                        <div class="tool-details">
                                            <span class="tool-details-label">Best for</span>
                                            <span class="tool-details-value">@skill.PrimaryUseCase</span>
                                        </div>
                                        <p class="adoption-signal">@skill.AdoptionSignal</p>
                                        <div class="tool-actions">
                                            <a href="@skill.GuideUrl" target="_blank" rel="noopener noreferrer" class="tool-link">
                                                <i class="bi bi-book"></i> Ecosystem docs
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(skill.RepositoryUrl))
                                            {
                                                <a href="@skill.RepositoryUrl" target="_blank" rel="noopener noreferrer" class="tool-link secondary-link">
                                                    <i class="bi bi-github"></i> Reference repo
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
