@page
@model MCPModel
@{
    ViewData["Title"] = "Curated MCP Servers";
    ViewData["Description"] = "Curated MCP servers for modern AI workflows: repository automation, live search, databases, collaboration, and cloud platforms - reviewed for April 2026.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/MCP";
}

@section Styles {
    <link rel="stylesheet" href="~/css/category-cards.css" />
    <link rel="stylesheet" href="~/css/skills.css" asp-append-version="true" />
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "plugin" },
        { "HeaderTitle", "Curated MCP Servers" },
        { "HeaderDescription", "A tighter, workflow-first selection of MCP servers that still matter in April 2026." },
        { "HeaderTokenColor", "attribute" }
    })' />

    <div class="mcp-categories">
        @foreach (var category in Model.Categories)
        {
            <article class="card category-card">
                <header class="card-header bg-@category.ColorClass">
                    <div class="category-header-content">
                        <div>
                            <h2 class="h4 mb-0">
                                <i class="bi @category.Icon"></i> @category.Name
                            </h2>
                            <p class="category-description mb-0 mt-2 small">@category.Description</p>
                        </div>
                        <span class="category-count">
                            @category.Tools.Count server@(category.Tools.Count > 1 ? "s" : "")
                        </span>
                    </div>
                </header>
                <div class="card-body p-0">
                    <div class="skills-grid">
                        @foreach (var tool in category.Tools)
                        {
                            <div class="skill-card">
                                <div class="tool-icon-wrapper">
                                    @if (!string.IsNullOrEmpty(tool.ImageUrl))
                                    {
                                        <img src="@tool.ImageUrl" alt="@tool.Name" class="tool-image" />
                                    }
                                    else
                                    {
                                        <i class="bi @tool.Icon tool-icon"></i>
                                    }
                                </div>
                                <div class="tool-content">
                                    <div class="tool-meta">
                                        <span class="badge-trust">@tool.TrustLevel</span>
                                        <span class="badge-access">@tool.AccessMode</span>
                                    </div>
                                    <h3 class="tool-name">@tool.Name</h3>
                                    <p class="tool-description">@tool.Description</p>
                                    <div class="tool-details">
                                        <span class="tool-details-label">Best for</span>
                                        <span class="tool-details-value">@tool.PrimaryUseCase</span>
                                    </div>
                                    <a href="@tool.GuideUrl" target="_blank" rel="noopener noreferrer" class="tool-link">
                                        <i class="bi bi-book"></i> Open docs
                                        <i class="bi bi-box-arrow-up-right" style="margin-left: 0.25rem;"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
</div>

<style>
    .mcp-categories {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .tool-image {
        width: 60%;
        height: 60%;
        object-fit: contain;
    }
</style>
