@page
@model MCPModel
@{
    ViewData["Title"] = "Curated MCP Servers";
    ViewData["Description"] = "Curated MCP servers for modern AI workflows: repository automation, live search, databases, collaboration, and cloud platforms - reviewed for April 2026.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/MCP";
}

<div class="container-fluid">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) { { "Icon", "plugin" }, { "HeaderTitle", "Curated MCP Servers" }, { "HeaderDescription", "A tighter, workflow-first selection of MCP servers that still matter in April 2026" } })' />
    <!-- Categories Grid -->
    <div class="row g-4">
        @foreach (var category in Model.Categories)
        {
            <div class="col-12 mb-4">
                <div class="card h-100 category-card">
                    <div class="card-header bg-@category.ColorClass">
                        <div class="category-header-content">
                            <div>
                                <h2 class="h4 mb-0">
                                    <i class="bi @category.Icon"></i> @category.Name
                                </h2>
                                <p class="category-description mb-0 mt-2 small">@category.Description</p>
                            </div>
                            <span class="category-count">@category.Tools.Count server@(category.Tools.Count > 1 ? "s" : "")</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="row g-0 mcp-tools-grid">
                            @foreach (var tool in category.Tools)
                            {
                                <div class="col-lg-6 col-xl-4">
                                    <div class="mcp-tool-card">
                                        <div class="tool-icon-wrapper">
                                            @if (!string.IsNullOrEmpty(tool.ImageUrl))
                                            {
                                                <img src="@tool.ImageUrl" alt="@tool.Name" class="tool-image" />
                                            }
                                            else
                                            {
                                                <i class="bi @tool.Icon tool-icon"></i>
                                            }
                                        </div>
                                        <div class="tool-content">
                                            <div class="tool-meta">
                                                <span class="badge badge-trust">@tool.TrustLevel</span>
                                                <span class="badge badge-access">@tool.AccessMode</span>
                                            </div>
                                            <h3 class="tool-name">@tool.Name</h3>
                                            <p class="tool-description">@tool.Description</p>
                                            <div class="tool-details">
                                                <span class="tool-details-label">Best for</span>
                                                <span class="tool-details-value">@tool.PrimaryUseCase</span>
                                            </div>
                                            <a href="@tool.GuideUrl" target="_blank" rel="noopener noreferrer" class="tool-link">
                                                <i class="bi bi-book"></i> Open docs
                                                <i class="bi bi-box-arrow-up-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Back to Dashboard -->
    <div class="row mt-5 mb-4">
        <div class="col-12 text-center">
            <a href="/" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/category-cards.css" />
}

<style>
    /* Page-specific category card overrides */
    .category-card {
        border: 1px solid var(--vs-border);
        background: var(--vs-panel);
    }

    .curation-card,
    .summary-card {
        min-height: 100%;
    }

    .category-card .card-header {
        padding: 1.5rem;
        border-bottom: 2px solid rgba(255, 255, 255, 0.1);
    }

    .category-header-content {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .category-card .card-header .small {
        opacity: 0.9;
        font-size: 0.9rem;
    }

    .category-card .card-header h2 {
        color: inherit;
    }

    .category-description {
        color: inherit;
    }

    .category-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(15, 15, 15, 0.25);
        color: var(--vs-text);
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .curation-pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .curation-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        background: rgba(0, 122, 204, 0.12);
        border: 1px solid rgba(0, 122, 204, 0.3);
        color: var(--vs-accent-strong);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .choice-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .choice-card {
        padding: 1rem;
        border-radius: 10px;
        background: var(--vs-panel-alt);
        border: 1px solid var(--vs-border);
    }

    .choice-title {
        font-size: 0.95rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--vs-text);
    }

    .choice-text {
        font-size: 0.85rem;
        color: var(--vs-muted);
        margin-bottom: 0;
        line-height: 1.5;
    }

    .summary-stat {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--vs-border);
    }

    .summary-stat:last-of-type {
        margin-bottom: 1rem;
    }

    .summary-value {
        font-size: 1.65rem;
        font-weight: 800;
        color: var(--vs-accent-strong);
    }

    .summary-label {
        font-size: 0.9rem;
        color: var(--vs-muted);
        text-align: right;
    }

    /* MCP Tools Grid */
    .mcp-tools-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .mcp-tool-card {
        padding: 1.5rem;
        border-right: 1px solid var(--vs-border);
        border-bottom: 1px solid var(--vs-border);
        background: var(--vs-panel-alt);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .mcp-tool-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--vs-accent-strong) 0%, var(--vs-purple) 100%);
        transition: width 0.3s ease;
    }

    .mcp-tool-card:hover {
        background: rgba(0, 122, 204, 0.05);
        transform: translateY(-4px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }

    .mcp-tool-card:hover::before {
        width: 100%;
    }

    /* Tool Icon */
    .tool-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--vs-panel) 0%, var(--vs-bg) 100%);
        border: 2px solid var(--vs-border);
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .mcp-tool-card:hover .tool-icon-wrapper {
        background: linear-gradient(135deg, var(--vs-accent-strong) 0%, var(--vs-purple) 100%);
        border-color: var(--vs-accent-strong);
        transform: scale(1.1) rotate(5deg);
    }

    .tool-icon {
        font-size: 1.75rem;
        color: var(--vs-accent-strong);
        transition: color 0.3s ease;
    }

    .mcp-tool-card:hover .tool-icon {
        color: #fff;
    }

    .tool-image {
        width: 60%;
        height: 60%;
        object-fit: contain;
    }

    /* Tool Content */
    .tool-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .tool-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--vs-text);
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .tool-description {
        font-size: 0.9rem;
        color: var(--vs-muted);
        line-height: 1.5;
        margin-bottom: 1rem;
        flex: 1;
    }

    /* Tool Meta */
    .tool-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .badge-trust,
    .badge-access {
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-trust {
        background: rgba(0, 122, 204, 0.15);
        color: var(--vs-accent-strong);
        border: 1px solid rgba(0, 122, 204, 0.3);
    }

    .badge-access {
        background: rgba(156, 39, 176, 0.12);
        color: #d9a6ff;
        border: 1px solid rgba(156, 39, 176, 0.35);
    }

    .mcp-tool-card:hover .badge-trust {
        background: rgba(0, 122, 204, 0.25);
        border-color: var(--vs-accent-strong);
    }

    .mcp-tool-card:hover .badge-access {
        background: rgba(156, 39, 176, 0.2);
        border-color: rgba(156, 39, 176, 0.45);
    }

    .tool-details {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 1rem;
        padding: 0.85rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--vs-border);
        background: rgba(255, 255, 255, 0.02);
    }

    .tool-details-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--vs-muted);
        font-weight: 600;
    }

    .tool-details-value {
        font-size: 0.9rem;
        color: var(--vs-text);
        font-weight: 600;
    }

    /* Tool Link */
    .tool-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: rgba(0, 122, 204, 0.1);
        border: 1px solid var(--vs-accent-strong);
        border-radius: 6px;
        color: var(--vs-accent-strong);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        align-self: flex-start;
    }

    .tool-link:hover {
        background: var(--vs-accent-strong);
        color: #fff;
        transform: translateX(4px);
    }

    /* Responsive Grid Adjustments */
    @@media (max-width: 1199px) {
        .choice-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .col-xl-4:nth-child(3n) .mcp-tool-card {
            border-right: none;
        }
    }

    @@media (max-width: 991px) {
        .col-lg-6:nth-child(2n) .mcp-tool-card {
            border-right: none;
        }
    }

    @@media (max-width: 767px) {
        .category-header-content {
            flex-direction: column;
        }

        .choice-grid {
            grid-template-columns: 1fr;
        }

        .mcp-tool-card {
            border-right: none;
        }

        .tool-icon-wrapper {
            width: 50px;
            height: 50px;
        }

        .tool-icon {
            font-size: 1.5rem;
        }

        .tool-name {
            font-size: 1rem;
        }

        .tool-description {
            font-size: 0.85rem;
        }
    }

    /* Use shared animation keyframe */
    .category-card {
        animation: categorySlideInUp 0.6s ease-out backwards;
    }

    /* Individual animation delays */
    .col-12:nth-child(1) .category-card {
        animation-delay: 0.1s;
    }

    .col-12:nth-child(2) .category-card {
        animation-delay: 0.2s;
    }

    .col-12:nth-child(3) .category-card {
        animation-delay: 0.3s;
    }

    /* MCP Tool Cards stagger animation */
    .mcp-tool-card {
        animation: categorySlideInUp 0.5s ease-out backwards;
    }

    .mcp-tools-grid > div:nth-child(1) .mcp-tool-card {
        animation-delay: 0.2s;
    }

    .mcp-tools-grid > div:nth-child(2) .mcp-tool-card {
        animation-delay: 0.3s;
    }

    .mcp-tools-grid > div:nth-child(3) .mcp-tool-card {
        animation-delay: 0.4s;
    }

    .mcp-tools-grid > div:nth-child(4) .mcp-tool-card {
        animation-delay: 0.5s;
    }

    .mcp-tools-grid > div:nth-child(5) .mcp-tool-card {
        animation-delay: 0.6s;
    }
</style>
