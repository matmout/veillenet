@page
@using VeilleNet.Models
@model TrainingModel
@{
    ViewData["Title"] = "Training";
    ViewData["Description"] = "Test your C# and .NET knowledge with our interactive quiz. Random developer interview questions with multiple choice and free text answers.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/Training";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "mortarboard" },
        { "HeaderTitle", "Training" },
        { "HeaderDescription", "Random C# and .NET interview questions — multiple choice and free text." },
        { "HeaderTokenColor", "function" }
    })' />

    <section class="training-stats">
        <div class="stat-card" data-tone="success">
            <i class="bi bi-check-circle stat-icon" aria-hidden="true"></i>
            <div class="stat-value">@Model.Session.CorrectAnswers</div>
            <div class="stat-label">Correct</div>
        </div>
        <div class="stat-card" data-tone="error">
            <i class="bi bi-x-circle stat-icon" aria-hidden="true"></i>
            <div class="stat-value">@Model.Session.IncorrectAnswers</div>
            <div class="stat-label">Incorrect</div>
        </div>
        <div class="stat-card" data-tone="info">
            <i class="bi bi-question-circle stat-icon" aria-hidden="true"></i>
            <div class="stat-value">@Model.RemainingQuestions</div>
            <div class="stat-label">Remaining</div>
        </div>
        <div class="stat-card" data-tone="warn">
            <i class="bi bi-collection stat-icon" aria-hidden="true"></i>
            <div class="stat-value">@Model.TotalQuestions</div>
            <div class="stat-label">Total</div>
        </div>
    </section>

    @if (Model.CurrentQuestion != null)
    {
        <article class="content-card training-question" data-token="function">
            <header class="training-question-head">
                <span class="content-card-title">
                    <i class="bi bi-chat-square-text"></i> question
                </span>
                <span class="timeline-chip" data-token="function">@Model.CurrentQuestion.Category</span>
            </header>

            <h2 class="training-question-text">@Model.CurrentQuestion.Text</h2>

            @if (!Model.ShowResult)
            {
                <form method="post" asp-page-handler="SubmitAnswer" class="training-form">
                    <input type="hidden" name="CurrentQuestionId" value="@Model.CurrentQuestion.Id" />

                    @if (Model.CurrentQuestion.Type == QuestionType.MultipleChoice)
                    {
                        <div class="training-choices">
                            @foreach (var choice in Model.CurrentQuestion.Choices)
                            {
                                <label class="training-choice">
                                    <input type="radio" name="UserAnswer" value="@choice" required />
                                    <span>@choice</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <label class="filter-bar-label" for="user-answer">Your answer</label>
                        <input id="user-answer"
                               type="text"
                               class="briefing-cta-input"
                               name="UserAnswer"
                               required />
                    }

                    <div class="content-card-actions">
                        <button type="submit" class="briefing-cta-submit">
                            <i class="bi bi-check-lg"></i> Submit
                        </button>
                    </div>
                </form>
            }
            else
            {
                var resultToken = Model.IsCorrect ? "string" : "preprocessor";
                <div class="training-result" data-tone="@(Model.IsCorrect ? "ok" : "err")">
                    <div class="training-result-head">
                        <i class="bi bi-@(Model.IsCorrect ? "check-circle-fill" : "x-circle-fill")" aria-hidden="true"></i>
                        <h3>@(Model.IsCorrect ? "Correct answer." : "Incorrect answer.")</h3>
                    </div>

                    @if (!Model.IsCorrect)
                    {
                        <div class="training-correct">
                            <span class="filter-bar-label">expected</span>
                            <span>@Model.CurrentQuestion.CorrectAnswer</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.CurrentQuestion.Explanation))
                    {
                        <div class="training-explanation">
                            <i class="bi bi-lightbulb" aria-hidden="true"></i>
                            <div>
                                <span class="filter-bar-label">explanation</span>
                                <p>@Model.CurrentQuestion.Explanation</p>
                            </div>
                        </div>
                    }

                    <form method="post" asp-page-handler="NextQuestion" class="content-card-actions">
                        <input type="hidden" name="CurrentQuestionId" value="@Model.CurrentQuestion.Id" />
                        <button type="submit" class="briefing-cta-submit">
                            <i class="bi bi-arrow-right"></i> Next question
                        </button>
                    </form>
                </div>
            }
        </article>
    }
    else
    {
        var percentage = Model.TotalQuestions > 0
            ? (Model.Session.CorrectAnswers * 100.0 / Model.TotalQuestions)
            : 0;

        <article class="content-card" data-token="string">
            <span class="content-card-title">
                <i class="bi bi-trophy"></i> session_complete
            </span>
            <h2>You've answered all available questions.</h2>
            <p>
                Final score: <strong>@Model.Session.CorrectAnswers / @Model.TotalQuestions</strong>
                — success rate: <strong>@percentage.ToString("F1")%</strong>.
            </p>
        </article>
    }

    <div class="content-card-actions training-cta">
        <form method="post" asp-page-handler="ResetSession">
            <button type="submit" class="output-action">
                <i class="bi bi-arrow-clockwise"></i> new session
            </button>
        </form>
        <a class="output-action" asp-page="/Index">
            <i class="bi bi-arrow-left"></i> back to dashboard
        </a>
    </div>
</div>

@section Styles {
    <style>
        .training-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: var(--space-3);
        }

        .stat-card {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
            padding: var(--space-4);
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            position: relative;
            overflow: hidden;
        }
        .stat-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 2px;
            background: var(--panel-token, var(--token-keyword));
            opacity: 0.85;
        }
        .stat-card[data-tone="success"] { --panel-token: var(--token-string); }
        .stat-card[data-tone="error"]   { --panel-token: var(--token-preprocessor); }
        .stat-card[data-tone="info"]    { --panel-token: var(--token-attribute); }
        .stat-card[data-tone="warn"]    { --panel-token: var(--token-type); }

        .stat-icon { color: var(--panel-token); font-size: 1.2rem; }
        .stat-value {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1;
        }
        .stat-label {
            font-family: var(--font-mono);
            font-size: var(--text-xs);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .training-question {
            display: flex;
            flex-direction: column;
            gap: var(--space-4);
        }
        .training-question-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--space-3);
        }
        .training-question-head .content-card-title { margin: 0; }
        .training-question-text {
            margin: 0;
            font-family: var(--font-ui);
            font-size: 1.3rem;
            line-height: 1.5;
            color: var(--text);
            font-weight: 500;
        }

        .training-form { display: flex; flex-direction: column; gap: var(--space-3); }
        .training-choices { display: flex; flex-direction: column; gap: var(--space-2); }
        .training-choice {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            padding: var(--space-3) var(--space-4);
            background: var(--panel-alt);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            cursor: pointer;
            transition: border-color var(--motion-fast), background var(--motion-fast);
            color: var(--text);
            font-family: var(--font-ui);
            font-size: 1rem;
        }
        .training-choice:hover { border-color: var(--accent); }
        .training-choice input[type="radio"] {
            accent-color: var(--accent);
            width: 16px;
            height: 16px;
        }
        .training-choice:has(input:checked) {
            border-color: var(--accent);
            color: var(--accent);
            background: color-mix(in oklab, var(--accent) 10%, transparent);
        }

        .training-result {
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
            padding: var(--space-4);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            background: var(--panel-alt);
        }
        .training-result[data-tone="ok"]  { border-color: color-mix(in oklab, var(--token-string) 50%, var(--border)); }
        .training-result[data-tone="err"] { border-color: color-mix(in oklab, var(--token-preprocessor) 50%, var(--border)); }
        .training-result-head { display: flex; align-items: center; gap: var(--space-3); }
        .training-result-head i { font-size: 1.5rem; }
        .training-result[data-tone="ok"]  .training-result-head i { color: var(--token-string); }
        .training-result[data-tone="err"] .training-result-head i { color: var(--token-preprocessor); }
        .training-result-head h3 { margin: 0; font-family: var(--font-ui); font-size: 1.1rem; color: var(--text); }

        .training-correct,
        .training-explanation {
            display: flex;
            gap: var(--space-3);
            padding: var(--space-3);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--panel);
        }
        .training-correct { flex-direction: column; gap: 0.25rem; }
        .training-correct span:last-child { color: var(--text); font-family: var(--font-mono); }
        .training-explanation i {
            color: var(--token-type);
            font-size: 1rem;
            line-height: 1.5;
            flex-shrink: 0;
        }
        .training-explanation > div { display: flex; flex-direction: column; gap: 0.25rem; }
        .training-explanation p { margin: 0; color: var(--text-soft); line-height: 1.55; }

        .training-cta { justify-content: flex-end; }
    </style>
}
