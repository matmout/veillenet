@page
@model VeilleNet.Pages.KnowledgeGraphModel
@{
    ViewData["Title"] = "Graph";
    ViewData["Description"] = "Interactive knowledge graph exploring relationships across ContainSharp news topics, technologies, and signals.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/KnowledgeGraph";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/knowledge-graph.css" asp-append-version="true" />
}

<div class="graph-wrapper">
    <h1 class="kg-visually-hidden">Knowledge graph</h1>

    <div class="loading-overlay" id="loader">
        <div class="loader-container">
            <div class="loader-ring" aria-hidden="true"></div>
            <div class="loader-text" id="loader-text" role="status" aria-live="polite">Initializing Neural Network</div>
            <div class="loader-status">System Loading</div>
        </div>
    </div>

    <div class="info-box glass-panel" id="info-box">
        <button type="button" class="close-info" id="info-close" aria-label="Close">&times;</button>
        <h3>Neural Explorer</h3>
        <p>
            Navigate the .NET ecosystem knowledge graph. Click nodes to explore AI-generated summaries and discover connections between technologies, frameworks, and latest news.
        </p>
    </div>

    <div class="hud-right">
        <div class="stats-badge">
            <div class="stat-item glass-panel">
                <span class="stat-value" id="node-count">0</span>
                <div class="stat-label">Nodes</div>
            </div>
            <div class="stat-item glass-panel">
                <span class="stat-value" id="link-count">0</span>
                <div class="stat-label">Connections</div>
            </div>
        </div>

        <div class="graph-controls">
            <button type="button" class="control-btn" id="reset-view" title="Reset view" aria-label="Reset view">
                <span aria-hidden="true">⟲</span>
            </button>
        </div>
    </div>

    <div id="graph" role="img" aria-label="Interactive 3D knowledge graph linking topics and articles. Use the side panel for details." data-endpoint="@Url.Content("~/api/GraphApi/data")"></div>

    <div class="timeline-container glass-panel">
        <div class="timeline-header">
            <label class="timeline-title" for="timeline">Time Filter</label>
            <span class="date-range-display" id="date-range">Last 30 Days</span>
        </div>
        <div class="timeline-controls">
            <div class="date-display" id="date-label">Latest</div>
            <input type="range" min="0" max="100" value="100" class="timeline-slider" id="timeline" aria-label="Time filter">
        </div>
    </div>

    <div class="side-panel" id="side-panel" role="region" aria-labelledby="panel-title">
        <div class="panel-header">
            <h2 id="panel-title">Article Details</h2>
            <button type="button" class="close-btn" id="panel-close" aria-label="Close details">&times;</button>
        </div>
        <div class="panel-content" id="panel-content">
        </div>
    </div>
</div>

@section Scripts {
    <script defer src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
    <script defer src="https://unpkg.com/d3@7.8.5/dist/d3.min.js"></script>
    <script defer src="https://unpkg.com/three-spritetext@1.9.1/dist/three-spritetext.min.js"></script>
    <script defer src="https://unpkg.com/3d-force-graph@1.73.0/dist/3d-force-graph.min.js"></script>
    <script defer src="~/js/pages/knowledge-graph.js" asp-append-version="true"></script>
}
