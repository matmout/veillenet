@model VeilleNet.Models.ViewModels.NewsBlockViewModel

<div class="card shadow-sm h-100">
    <div class="card-header @Model.HeaderCssClass" @(Model.HeaderStyle != null ? $"style=\"{Model.HeaderStyle}\"" : "")>
        <h2 class="h4 mb-0">
            @if (Model.HeaderIconHtml != null)
            {
                @Html.Raw(Model.HeaderIconHtml)
            }
            else
            {
                <i class="bi @Model.Icon"></i>
            }
            @Model.Title
            @if (Model.HeaderBadgeHtml != null)
            {
                @Html.Raw(Model.HeaderBadgeHtml)
            }
        </h2>
    </div>
    <div class="card-body" style="max-height: @(Model.MaxHeight)px; overflow-y: auto;">
        @if (Model.Items.Any())
        {
            @if (Model.ColumnsPerRow > 1)
            {
                <div class="row g-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="col-md-@(12 / Model.ColumnsPerRow)">
                            @await Html.PartialAsync("_NewsBlockItemPartial", (Model, item))
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        @await Html.PartialAsync("_NewsBlockItemPartial", (Model, item))
                    }
                </div>
            }
        }
        else
        {
            @if (Model.HasEmptyState)
            {
                <div class="news-block-empty-state" role="status" aria-live="polite">
                    <div class="news-block-empty-state-icon">
                        <i class="bi @Model.EmptyStateIcon" aria-hidden="true"></i>
                    </div>
                    <div>
                        @if (!string.IsNullOrWhiteSpace(Model.EmptyStateTitle))
                        {
                            <p class="news-block-empty-state-title mb-2">@Model.EmptyStateTitle</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.EmptyStateMessage))
                        {
                            <p class="news-block-empty-state-message mb-0">@Model.EmptyStateMessage</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted text-center">@Model.LoadingText</p>
            }
        }
    </div>
</div>
