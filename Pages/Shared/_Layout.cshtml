<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - Contain('Sharp')" : "Contain('Sharp') - Your daily dose of C#")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "ContainSharp - Your daily dose of C#. Stay updated with official .NET blogs, releases, GitHub trends, AI tools, and essential resources for C# developers.")" />
    <meta name="keywords" content="C#, .NET, ASP.NET, Visual Studio, GitHub, AI tools, WinForms, development, programming" />
    <meta name="author" content="ContainSharp" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? "https://containsharp.com")" />
    <meta property="og:title" content="@(ViewData["Title"] != null ? ViewData["Title"] + " - Contain('Sharp')" : "Contain('Sharp') - Your daily dose of C#")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "ContainSharp - Your daily dose of C#. Stay updated with official .NET blogs, releases, GitHub trends, AI tools, and essential resources for C# developers.")" />
    <meta property="og:image" content="https://containsharp.com/icons/containsharp.png" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="@(ViewData["CanonicalUrl"] ?? "https://containsharp.com")" />
    <meta property="twitter:title" content="@(ViewData["Title"] != null ? ViewData["Title"] + " - Contain('Sharp')" : "Contain('Sharp') - Your daily dose of C#")" />
    <meta property="twitter:description" content="@(ViewData["Description"] ?? "ContainSharp - Your daily dose of C#. Stay updated with official .NET blogs, releases, GitHub trends, AI tools, and essential resources for C# developers.")" />
    <meta property="twitter:image" content="https://containsharp.com/icons/containsharp.png" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? "https://containsharp.com")" />
    <link rel="icon" type="image/svg+xml" href="~/icons/containsharp.svg" />
    <link rel="alternate icon" type="image/png" href="~/icons/containsharp.png" />
    <!-- Preload critical resources for LCP/FCP -->
    <link rel="preload" href="~/css/site.css" as="style" />
    <link rel="preload" href="~/icons/containsharp.svg" as="image" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/bootstrap.purged.min.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Share+Tech&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/scrollbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ai-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-light.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <!-- Apply saved/preferred theme immediately to prevent FOUC -->
    <script>(function(){var t=localStorage.getItem('containsharp-theme')||(window.matchMedia('(prefers-color-scheme:light)').matches?'light':'dark');document.documentElement.setAttribute('data-bs-theme',t)})();</script>
</head>
<body>
    <!-- Skip to main content link for keyboard navigation -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        bool IsActive(params string[] pages) => pages.Any(p => string.Equals(p, currentPage, StringComparison.OrdinalIgnoreCase));
        var activeNews = IsActive("/Index", "/History", "/KnowledgeGraph", "/Releases", "/Radar");
        var activeCsharp = IsActive("/Roadmap", "/Training", "/Liens");
        var activeAi = IsActive("/MCP", "/LatestLLM", "/Skills", "/AiSummary");
        var activeNewsletter = IsActive("/NewsletterArchive", "/Newsletter");
    }
    <header class="ide-chrome" role="banner">
        <!-- Title bar -->
        <div class="ide-titlebar">
            <a class="ide-titlebar-brand" asp-area="" asp-page="/Index" aria-label="ContainSharp - Home">
                <img src="~/icons/containsharp.svg" alt="" aria-hidden="true" />
                <span>Contain<span class="bracket">(&apos;</span>Sharp<span class="bracket">&apos;)</span></span>
            </a>
            <span class="ide-titlebar-path" aria-hidden="true">
                <span class="sep">/</span>
                <span class="tabular-nums">main</span>
                <span class="sep">·</span>
                <span class="tabular-nums">.NET 10</span>
            </span>
            <span class="ide-titlebar-spacer"></span>
            <button id="ide-mobile-toggle" class="ide-mobile-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="ide-tabbar">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <div class="ide-titlebar-actions">
                <button id="theme-toggle" class="btn-icon theme-toggle" type="button" title="Toggle dark/light mode" aria-label="Toggle dark/light mode">
                    <i id="theme-icon" class="bi bi-moon-stars-fill" aria-hidden="true"></i>
                </button>
                <a class="btn-icon" href="https://github.com/matmout/veillenet" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub repository">
                    <i class="bi bi-github" aria-hidden="true"></i>
                </a>
                <a class="dev-typer" asp-area="" asp-page="/About" title="About" aria-label="About - Learn more about this site">
                    <div class="dev">
                        <div class="dev-head"></div>
                        <div class="dev-body">
                            <div class="dev-screen"></div>
                            <div class="dev-hands">
                                <div class="dev-hand left"></div>
                                <div class="dev-hand right"></div>
                            </div>
                            <div class="dev-keyboard"></div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Tab bar (editor tabs) -->
        <nav class="ide-tabbar" id="ide-tabbar" role="navigation" aria-label="Main navigation">
            <div class="ide-tab-group">
                <a class="ide-tab @(activeNews ? "active" : "")" data-token="string" asp-area="" asp-page="/Index" aria-haspopup="true">
                    news.cs
                </a>
                <div class="ide-subtabs" role="menu">
                    <a class="ide-subtab" asp-area="" asp-page="/Index" role="menuitem"><i class="bi bi-house" aria-hidden="true"></i> Dashboard</a>
                    <a class="ide-subtab" asp-area="" asp-page="/History" role="menuitem"><i class="bi bi-clock-history" aria-hidden="true"></i> History</a>
                    <a class="ide-subtab" asp-area="" asp-page="/KnowledgeGraph" role="menuitem"><i class="bi bi-diagram-3" aria-hidden="true"></i> Graph</a>
                    <a class="ide-subtab" asp-area="" asp-page="/Releases" role="menuitem"><i class="bi bi-tag" aria-hidden="true"></i> Releases</a>
                    <a class="ide-subtab" asp-area="" asp-page="/Radar" role="menuitem"><i class="bi bi-broadcast-pin" aria-hidden="true"></i> Radar</a>
                </div>
            </div>

            <div class="ide-tab-group">
                <a class="ide-tab @(activeCsharp ? "active" : "")" data-token="keyword" asp-area="" asp-page="/Roadmap" aria-haspopup="true">
                    csharp.cs
                </a>
                <div class="ide-subtabs" role="menu">
                    <a class="ide-subtab" asp-area="" asp-page="/Roadmap" role="menuitem"><i class="bi bi-signpost-2" aria-hidden="true"></i> Roadmap</a>
                    <a class="ide-subtab" asp-area="" asp-page="/Training" role="menuitem"><i class="bi bi-mortarboard" aria-hidden="true"></i> Training</a>
                    <a class="ide-subtab" asp-area="" asp-page="/Liens" role="menuitem"><i class="bi bi-link-45deg" aria-hidden="true"></i> Links</a>
                </div>
            </div>

            <div class="ide-tab-group">
                <a class="ide-tab @(activeAi ? "active" : "")" data-token="type" asp-area="" asp-page="/MCP" aria-haspopup="true">
                    ai.cs
                </a>
                <div class="ide-subtabs" role="menu">
                    <a class="ide-subtab" asp-area="" asp-page="/MCP" role="menuitem"><i class="bi bi-plugin" aria-hidden="true"></i> MCP</a>
                    <a class="ide-subtab" asp-area="" asp-page="/LatestLLM" role="menuitem"><i class="bi bi-cpu" aria-hidden="true"></i> LLM</a>
                    <a class="ide-subtab" asp-area="" asp-page="/Skills" role="menuitem">
                        <i class="bi bi-lightning-charge" aria-hidden="true"></i> Skills
                        <span class="badge bg-warning">NEW</span>
                    </a>
                    <a class="ide-subtab" asp-area="" asp-page="/AiSummary" role="menuitem"><i class="bi bi-stars" aria-hidden="true"></i> AI Summary</a>
                </div>
            </div>

            <div class="ide-tab-group">
                <a class="ide-tab @(activeNewsletter ? "active" : "")" data-token="comment" asp-area="" asp-page="/NewsletterArchive" aria-haspopup="true">
                    newsletter.cs
                </a>
                <div class="ide-subtabs" role="menu">
                    <a class="ide-subtab" asp-area="" asp-page="/NewsletterArchive" role="menuitem"><i class="bi bi-archive" aria-hidden="true"></i> Archive</a>
                    <a class="ide-subtab" asp-area="" asp-page="/Newsletter" role="menuitem"><i class="bi bi-envelope-slash" aria-hidden="true"></i> Unsubscribe</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3" id="main-content" tabindex="-1" aria-label="Main content">
            @RenderBody()
        </main>
    </div>

    <footer class="ide-statusbar" role="contentinfo" aria-label="Site status">
        <div class="ide-statusbar-group ide-statusbar-left">
            <span class="status-chip" aria-label="Cursor position">
                <i class="bi bi-cursor" aria-hidden="true"></i>
                <span class="tabular-nums">Ln 1, Col 1</span>
            </span>
            <span class="status-chip">UTF-8</span>
            <span class="status-chip">C# 13</span>
            <span class="status-chip" aria-label="Git branch">
                <i class="bi bi-git" aria-hidden="true"></i>
                main
            </span>
        </div>
        <span class="ide-statusbar-spacer"></span>
        <div class="ide-statusbar-group ide-statusbar-right">
            <a class="status-chip status-link" asp-area="" asp-page="/About">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                About
            </a>
            <a class="status-chip status-link" asp-area="" asp-page="/Privacy">
                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                Privacy
            </a>
            <a class="status-chip status-link" href="https://github.com/matmout" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile (opens in new tab)">
                <i class="bi bi-github" aria-hidden="true"></i>
                matmout
            </a>
            <span class="status-chip">&copy; 2025&ndash;2026</span>
            <span class="status-chip status-online" aria-live="polite">
                <span class="dot" aria-hidden="true"></span>
                online
            </span>
        </div>
    </footer>

    <script>
    (function(){
      var btn = document.getElementById('ide-mobile-toggle');
      var bar = document.getElementById('ide-tabbar');
      if (!btn || !bar) return;
      btn.addEventListener('click', function(){
        var open = bar.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    })();
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/output-shrink.js" asp-append-version="true" defer></script>
    <script src="~/js/ai-modal.js" asp-append-version="true" defer></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Google Analytics 4 — loaded on idle to avoid blocking critical rendering -->
    <script>
    (function() {
      function loadGA4() {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-4B9NVDSYP2';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-4B9NVDSYP2');
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGA4, { timeout: 3000 });
      } else {
        window.addEventListener('load', function() { setTimeout(loadGA4, 1000); });
      }
    })();
    </script>
</body>
</html>
