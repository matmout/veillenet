@page
@model VeilleNet.Pages.Newsletter.ConfirmSubscriptionModel
@{
    ViewData["Title"] = "Confirm Subscription";

    var isSuccess = Model.IsConfirmed;
    var token = isSuccess ? "string" : "preprocessor";
    var iconClass = isSuccess ? "bi bi-check-circle-fill confirm-icon" : "bi bi-x-octagon";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", isSuccess ? "check-circle" : "x-octagon" },
        { "HeaderTitle", isSuccess ? "Subscription confirmed" : "Confirmation failed" },
        { "HeaderDescription", isSuccess
            ? "Your address is now on the daily briefing list."
            : "The confirmation link could not be validated." },
        { "HeaderTokenColor", token },
        { "HeaderFileSlug", "newsletter.confirm" }
    })' />

    <article class="content-card confirm-card" data-token="@token">
        <h2 class="content-card-title">
            <i class="@iconClass" aria-hidden="true"></i> @(isSuccess ? "result.ok" : "result.error")
        </h2>
        <p>@Model.Message</p>

        @if (isSuccess)
        {
            <p class="confirm-thanks">Thank you for joining the Contain'Sharp community.</p>
        }
        else
        {
            <div class="vs-alert vs-alert-error" role="alert">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span>If you believe this is an error, try subscribing again on the home page.</span>
            </div>
        }

        <div class="content-card-actions">
            <a class="output-action" href="/">
                <i class="bi bi-house" aria-hidden="true"></i> back to dashboard
            </a>
            @if (!isSuccess)
            {
                <a class="output-action" asp-page="/Newsletter">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> try again
                </a>
            }
        </div>
    </article>
</div>

<!-- Fireworks Canvas for Success Animation -->
<canvas id="fireworks-canvas" class="fireworks-canvas" aria-hidden="true"></canvas>

@if (ViewData["TriggerFireworks"] as string == "true")
{
    <script>
        // Set attribute to trigger fireworks animation
        document.body.setAttribute('data-trigger-fireworks', 'true');
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/confirm-subscription.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/fireworks.js" asp-append-version="true"></script>
}
