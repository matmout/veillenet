@page
@model HistoryModel
@{
    ViewData["Title"] = "C# News Archive - Historical Articles";
    ViewData["Description"] = "Browse and search historical C# and .NET news articles. Access archived blog posts, releases, GitHub trends, and developer resources from previous dates.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/History";
}

<style>
    .history-filter-input {
        background-color: #0d1b2a;
        color: #e8f1ff;
        border: 1px solid #2d3f5f;
    }
    .history-filter-input:focus {
        background-color: #0d1b2a;
        color: #e8f1ff;
        border-color: #3b5b8a;
        box-shadow: 0 0 0 0.1rem rgba(59, 91, 138, 0.4);
    }
    .history-filter-input::placeholder {
        color: #9fb3d1;
        opacity: 1;
    }
    .history-filter-input option {
        background-color: #0d1b2a;
        color: #e8f1ff;
    }
</style>

<div class="container-fluid">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) { { "Icon", "archive" }, { "HeaderTitle", "News Archive" }, { "HeaderDescription", "Search by keywords, publication date, or publisher across all stored articles." } })' />

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body bg-light">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Keywords</label>
                            <input id="keyword" type="text" class="form-control history-filter-input" placeholder="e.g. Blazor, Azure, AI">
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="form-label">From</label>
                            <input id="startDate" type="date" class="form-control history-filter-input" value="@ViewData["DefaultStartDate"]">
                        </div>
                        <div class="col-lg-2 col-md-3">
                            <label class="form-label">To</label>
                            <input id="endDate" type="date" class="form-control history-filter-input">
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label">Publisher</label>
                            <select id="publisher" class="form-select history-filter-input">
                                <option value="">All</option>
                                @foreach (var src in Model.Sources)
                                {
                                    <option value="@src">@src</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4 d-flex gap-2">
                            <button id="searchBtn" class="btn btn-primary flex-grow-1"><i class="bi bi-search"></i> Search</button>
                            <button id="resetBtn" class="btn btn-outline-secondary" title="Reset filters"><i class="bi bi-arrow-counterclockwise"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Results</h5>
            <div class="text-muted small">Total: <span id="totalCount">@Model.TotalCount</span></div>
        </div>
    </div>

    <div class="row" id="results">
        @foreach (var news in Model.InitialNews)
        {
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex">
                            <div class="flex-shrink-0 me-3">
                                <img src="@(!string.IsNullOrEmpty(news.Image) ? news.Image : Url.Content("~/images/newsia.png"))" alt="@news.Title" style="width:90px; height:70px; object-fit:cover; border-radius:6px;" />
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="card-title mb-1"><a href="@news.Url" target="_blank" class="text-decoration-none">@news.Title</a></h5>
                                    <div class="d-flex align-items-center ms-2" style="gap:6px;">
                                        @if (news.HasAiSummary)
                                        {
                                            <a href="/AiSummary?url=@Uri.EscapeDataString(news.Url)" aria-label="Voir le résumé IA : @news.Title" class="flex-shrink-0">
                                                <img src="~/images/mcp/technologie-ia.png" alt="AI Summary Available" style="width: 24px; height: 24px;" />
                                            </a>
                                        }
                                        <span class="badge bg-secondary flex-shrink-0">@news.Source</span>
                                    </div>
                                </div>
                                <p class="card-text small text-muted mb-2">@Html.Raw(VeilleNet.Services.HtmlOutputSanitizer.Sanitize(news.Summary.Length > 200 ? news.Summary.Substring(0, news.Summary.Length < 260 ? news.Summary.Length  : 260) + "..." : news.Summary))</p>
                                <small class="text-muted"><i class="bi bi-calendar"></i> @news.PublishedDate.ToString("dd MMM yyyy")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row mt-2">
        <div class="col-12 d-flex justify-content-center gap-2">
            <button id="prevPage" class="btn btn-outline-secondary" disabled>Previous</button>
            <button id="nextPage" class="btn btn-outline-primary">Next</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const resultsEl = document.getElementById('results');
            const totalEl = document.getElementById('totalCount');
            const keywordEl = document.getElementById('keyword');
            const startDateEl = document.getElementById('startDate');
            const endDateEl = document.getElementById('endDate');
            const publisherEl = document.getElementById('publisher');
            const searchBtn = document.getElementById('searchBtn');
            const resetBtn = document.getElementById('resetBtn');
            const prevBtn = document.getElementById('prevPage');
            const nextBtn = document.getElementById('nextPage');

            let page = 1;
            const pageSize = 20;
            let total = parseInt(totalEl.textContent || '0');

            const renderItems = (items) => {
                if (!items || !items.length) {
                    resultsEl.innerHTML = '<div class="col-12"><div class="alert alert-info">No articles found.</div></div>';
                    return;
                }

                resultsEl.innerHTML = items.map(n => `
<div class="col-lg-6 mb-4">
  <div class="card shadow-sm h-100">
    <div class="card-body">
      <div class="d-flex">
        <div class="flex-shrink-0 me-3">
          <img src="${n.image || '@Url.Content("~/images/newsia.png")'}" alt="${n.title}" style="width:90px; height:70px; object-fit:cover; border-radius:6px;" />
        </div>
        <div class="flex-grow-1">
          <div class="d-flex justify-content-between align-items-start">
            <h5 class="card-title mb-1"><a href="${n.url}" target="_blank" class="text-decoration-none">${n.title}</a></h5>
            <div class="d-flex align-items-center ms-2" style="gap:6px;">
              ${n.hasSummary ? `<a href="/AiSummary?url=${encodeURIComponent(n.url)}" title="View AI Summary" class="flex-shrink-0"><img src="@Url.Content("~/images/mcp/technologie-ia.png")" alt="AI Summary Available" style="width: 24px; height: 24px;" /></a>` : ''}
              <span class="badge bg-secondary flex-shrink-0">${n.source}</span>
            </div>
          </div>
          <p class="card-text small text-muted mb-2">${n.summary || ''}</p>
          <small class="text-muted"><i class="bi bi-calendar"></i> ${n.publishedDate}</small>
        </div>
      </div>
    </div>
  </div>
</div>`).join('');
            };

            const updatePagingButtons = () => {
                prevBtn.disabled = page <= 1;
                const maxPage = Math.ceil(total / pageSize) || 1;
                nextBtn.disabled = page >= maxPage;
            };

            const ensureStartDate = () => {
                if (!startDateEl.value) {
                    const d = new Date();
                    d.setDate(d.getDate() - 30);
                    startDateEl.value = d.toISOString().split('T')[0];
                }
                return startDateEl.value;
            };

            const buildQuery = () => {
                const params = new URLSearchParams();
                if (keywordEl.value.trim()) params.append('keyword', keywordEl.value.trim());
                const startVal = ensureStartDate();
                if (startVal) params.append('startDate', startVal);
                if (endDateEl.value) params.append('endDate', endDateEl.value);
                if (publisherEl.value) params.append('source', publisherEl.value);
                params.append('page', page);
                params.append('pageSize', pageSize);
                return params.toString();
            };

            const load = async () => {
                const url = `?handler=Search&${buildQuery()}`;
                resultsEl.innerHTML = '<div class="col-12 text-center text-muted"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>';
                try {
                    const res = await fetch(url);
                    const data = await res.json();
                    total = data.total || 0;
                    totalEl.textContent = total;
                    renderItems(data.items || []);
                    updatePagingButtons();
                } catch (err) {
                    resultsEl.innerHTML = '<div class="col-12"><div class="alert alert-danger">Error loading results.</div></div>';
                }
            };

            searchBtn.addEventListener('click', () => { page = 1; load(); });
            resetBtn.addEventListener('click', () => {
                keywordEl.value = '';
                startDateEl.value = '';
                endDateEl.value = '';
                publisherEl.value = '';
                page = 1;
                load();
            });
            prevBtn.addEventListener('click', () => { if (page > 1) { page--; load(); } });
            nextBtn.addEventListener('click', () => { page++; load(); });

            [keywordEl].forEach(el => el.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); page = 1; load(); } }));

            // Ensure default start date on initial load
            ensureStartDate();
        })();
    </script>
}
