@page
@model HistoryModel
@{
    ViewData["Title"] = "Historical News";
    ViewData["Description"] = "Search all archived news articles across the ContainSharp technology watch dashboard.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/History";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "archive" },
        { "HeaderTitle", "News Archive" },
        { "HeaderDescription", "Search by keywords, publication date, or publisher across all stored articles." },
        { "HeaderTokenColor", "keyword" }
    })' />

    <form class="filter-bar" id="history-filter" onsubmit="return false;" aria-label="Search archived news">
        <div class="filter-bar-field grow">
            <label for="keyword" class="filter-bar-label">keywords</label>
            <input id="keyword" type="text" class="filter-bar-input"
                   placeholder="e.g. Blazor, Azure, AI" autocomplete="off" />
        </div>
        <div class="filter-bar-field">
            <label for="startDate" class="filter-bar-label">from</label>
            <input id="startDate" type="date" class="filter-bar-input"
                   value="@ViewData["DefaultStartDate"]" />
        </div>
        <div class="filter-bar-field">
            <label for="endDate" class="filter-bar-label">to</label>
            <input id="endDate" type="date" class="filter-bar-input" />
        </div>
        <div class="filter-bar-field">
            <label for="publisher" class="filter-bar-label">publisher</label>
            <select id="publisher" class="filter-bar-select">
                <option value="">all</option>
                @foreach (var src in Model.Sources)
                {
                    <option value="@src">@src</option>
                }
            </select>
        </div>
        <div class="filter-bar-actions">
            <button id="searchBtn" type="submit" class="output-action">
                <i class="bi bi-search"></i> search
            </button>
            <button id="resetBtn" type="reset" class="output-action" title="Reset filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
        </div>
    </form>

    <div class="history-summary">
        <span class="filter-bar-label">results</span>
        <span class="history-total tabular-nums">
            total: <strong id="totalCount">@Model.TotalCount</strong>
        </span>
    </div>

    <div class="history-grid" id="results">
        @foreach (var news in Model.InitialNews)
        {
            var thumb = !string.IsNullOrEmpty(news.Image)
                ? news.Image
                : Url.Content("~/images/newsia.png");
            var summary = news.Summary?.Length > 260
                ? news.Summary.Substring(0, 260) + "…"
                : news.Summary;

            <article class="content-card history-card" data-token="keyword">
                <div class="history-card-body">
                    <img class="history-thumb" src="@thumb" alt="@news.Title" loading="lazy" />
                    <div class="history-card-content">
                        <div class="history-card-head">
                            <h3 class="history-card-title">
                                <a href="@news.Url" target="_blank" rel="noopener">@news.Title</a>
                            </h3>
                            <div class="history-card-badges">
                                @if (news.HasAiSummary)
                                {
                                    <a href="/AiSummary?url=@Uri.EscapeDataString(news.Url)"
                                       aria-label="Voir le résumé IA : @news.Title"
                                       class="history-ai-link">
                                        <img src="~/images/mcp/technologie-ia.png" alt="" />
                                    </a>
                                }
                                <span class="timeline-chip" data-token="attribute">@news.Source</span>
                            </div>
                        </div>
                        <p class="history-card-summary">
                            @Html.Raw(VeilleNet.Services.HtmlOutputSanitizer.Sanitize(summary ?? ""))
                        </p>
                        <div class="timeline-meta">
                            <span><i class="bi bi-calendar"></i>@news.PublishedDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>

    <div class="history-pagination">
        <button id="prevPage" class="output-action" disabled>
            <i class="bi bi-arrow-left"></i> previous
        </button>
        <button id="nextPage" class="output-action">
            next <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

@section Styles {
    <style>
        .history-summary {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: var(--space-3);
            margin-bottom: var(--space-3);
            font-family: var(--font-mono);
            font-size: var(--text-sm);
            color: var(--text-muted);
        }
        .history-total strong {
            color: var(--text);
            font-variant-numeric: tabular-nums;
        }

        .history-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: var(--space-4);
        }

        .history-card { padding: var(--space-4); }
        .history-card-body {
            display: grid;
            grid-template-columns: 90px 1fr;
            gap: var(--space-3);
            align-items: start;
        }
        .history-thumb {
            width: 90px;
            height: 70px;
            object-fit: cover;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--panel-alt);
        }
        .history-card-content {
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
            min-width: 0;
        }
        .history-card-head {
            display: flex;
            gap: var(--space-2);
            align-items: flex-start;
            justify-content: space-between;
        }
        .history-card-title {
            margin: 0;
            font-family: var(--font-ui);
            font-size: var(--text-base);
            font-weight: 600;
            line-height: 1.3;
        }
        .history-card-title a {
            color: var(--text);
            text-decoration: none;
            transition: color var(--motion-fast);
        }
        .history-card-title a:hover { color: var(--accent); }
        .history-card-badges {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            flex-shrink: 0;
        }
        .history-ai-link img {
            width: 22px;
            height: 22px;
            display: block;
        }
        .history-card-summary {
            margin: 0;
            font-size: var(--text-sm);
            color: var(--text-soft);
            line-height: 1.55;
        }

        .history-pagination {
            display: flex;
            justify-content: center;
            gap: var(--space-2);
            margin-top: var(--space-5);
        }

        .history-empty,
        .history-error {
            grid-column: 1 / -1;
            padding: var(--space-5);
            text-align: center;
            font-family: var(--font-mono);
            font-size: var(--text-sm);
            color: var(--text-muted);
            border: 1px dashed var(--border);
            border-radius: var(--radius);
        }
        .history-error { color: var(--token-preprocessor); border-color: var(--token-preprocessor); }
    </style>
}

@section Scripts {
    <script>
        (() => {
            const resultsEl = document.getElementById('results');
            const totalEl = document.getElementById('totalCount');
            const keywordEl = document.getElementById('keyword');
            const startDateEl = document.getElementById('startDate');
            const endDateEl = document.getElementById('endDate');
            const publisherEl = document.getElementById('publisher');
            const searchBtn = document.getElementById('searchBtn');
            const resetBtn = document.getElementById('resetBtn');
            const prevBtn = document.getElementById('prevPage');
            const nextBtn = document.getElementById('nextPage');

            let page = 1;
            const pageSize = 20;
            let total = parseInt(totalEl.textContent || '0');

            const escapeHtml = (s) => (s || '').replace(/[&<>"']/g, c => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[c]));

            const renderItems = (items) => {
                if (!items || !items.length) {
                    resultsEl.innerHTML = '<div class="history-empty">No articles found.</div>';
                    return;
                }

                const fallbackImg = '@Url.Content("~/images/newsia.png")';
                const aiIcon = '@Url.Content("~/images/mcp/technologie-ia.png")';

                resultsEl.innerHTML = items.map(n => `
<article class="content-card history-card" data-token="keyword">
  <div class="history-card-body">
    <img class="history-thumb" src="${escapeHtml(n.image || fallbackImg)}" alt="${escapeHtml(n.title)}" loading="lazy" />
    <div class="history-card-content">
      <div class="history-card-head">
        <h3 class="history-card-title"><a href="${escapeHtml(n.url)}" target="_blank" rel="noopener">${escapeHtml(n.title)}</a></h3>
        <div class="history-card-badges">
          ${n.hasSummary ? `<a href="/AiSummary?url=${encodeURIComponent(n.url)}" class="history-ai-link" aria-label="AI summary"><img src="${aiIcon}" alt="" /></a>` : ''}
          <span class="timeline-chip" data-token="attribute">${escapeHtml(n.source)}</span>
        </div>
      </div>
      <p class="history-card-summary">${n.summary || ''}</p>
      <div class="timeline-meta"><span><i class="bi bi-calendar"></i>${escapeHtml(n.publishedDate)}</span></div>
    </div>
  </div>
</article>`).join('');
            };

            const updatePagingButtons = () => {
                prevBtn.disabled = page <= 1;
                const maxPage = Math.ceil(total / pageSize) || 1;
                nextBtn.disabled = page >= maxPage;
            };

            const ensureStartDate = () => {
                if (!startDateEl.value) {
                    const d = new Date();
                    d.setDate(d.getDate() - 30);
                    startDateEl.value = d.toISOString().split('T')[0];
                }
                return startDateEl.value;
            };

            const buildQuery = () => {
                const params = new URLSearchParams();
                if (keywordEl.value.trim()) params.append('keyword', keywordEl.value.trim());
                const startVal = ensureStartDate();
                if (startVal) params.append('startDate', startVal);
                if (endDateEl.value) params.append('endDate', endDateEl.value);
                if (publisherEl.value) params.append('source', publisherEl.value);
                params.append('page', page);
                params.append('pageSize', pageSize);
                return params.toString();
            };

            const load = async () => {
                const url = `?handler=Search&${buildQuery()}`;
                resultsEl.innerHTML = '<div class="history-empty">Loading…</div>';
                try {
                    const res = await fetch(url);
                    const data = await res.json();
                    total = data.total || 0;
                    totalEl.textContent = total;
                    renderItems(data.items || []);
                    updatePagingButtons();
                } catch (err) {
                    resultsEl.innerHTML = '<div class="history-error">Error loading results.</div>';
                }
            };

            searchBtn.addEventListener('click', () => { page = 1; load(); });
            resetBtn.addEventListener('click', () => {
                keywordEl.value = '';
                startDateEl.value = '';
                endDateEl.value = '';
                publisherEl.value = '';
                page = 1;
                load();
            });
            prevBtn.addEventListener('click', () => { if (page > 1) { page--; load(); } });
            nextBtn.addEventListener('click', () => { page++; load(); });

            keywordEl.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); page = 1; load(); }
            });

            ensureStartDate();
        })();
    </script>
}
