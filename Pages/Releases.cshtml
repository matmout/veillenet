@page
@model VeilleNet.Pages.ReleasesModel
@{
    ViewData["Title"] = "Release Notes";
    ViewData["Description"] = "Latest .NET ecosystem release notes — .NET Runtime, ASP.NET Core, Entity Framework Core, Roslyn, MAUI, Aspire. Stay up to date with official GitHub releases.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/Releases";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "tag" },
        { "HeaderTitle", "Release Notes" },
        { "HeaderDescription", "Latest releases across the .NET ecosystem, aggregated from official GitHub repositories." },
        { "HeaderTokenColor", "number" }
    })' />

    <nav class="filter-bar" aria-label="Filter by framework">
        <span class="filter-bar-label">framework</span>
        <div class="filter-bar-actions" style="margin-left: 0; flex-wrap: wrap;">
            <a asp-page="/Releases"
               class="filter-pill @(Model.SelectedFramework == null ? "is-active" : "")"
               aria-pressed="@(Model.SelectedFramework == null ? "true" : "false")">
                all
            </a>
            @foreach (var fw in Model.Frameworks)
            {
                var active = Model.SelectedFramework == fw;
                <a asp-page="/Releases" asp-route-framework="@fw"
                   class="filter-pill @(active ? "is-active" : "")"
                   aria-pressed="@(active ? "true" : "false")">
                    @fw
                </a>
            }
        </div>
    </nav>

    @if (Model.Releases.Any())
    {
        <ol class="timeline-list">
            @{ var lastMonth = ""; }
            @foreach (var release in Model.Releases)
            {
                var month = release.ReleaseDate.ToString("MMMM yyyy",
                    new System.Globalization.CultureInfo("en-US"));
                if (month != lastMonth)
                {
                    lastMonth = month;
                    <li class="timeline-group-label">@month.ToLowerInvariant()</li>
                }

                var typeToken = release.Type switch
                {
                    "Stable"  => "string",
                    "RC"      => "type",
                    "Preview" => "attribute",
                    _         => "keyword"
                };

                <li class="timeline-item">
                    <span class="timeline-date">
                        @release.ReleaseDate.ToString("dd MMM yyyy",
                            new System.Globalization.CultureInfo("en-US"))
                    </span>
                    <div class="timeline-content">
                        <h3 class="timeline-title">
                            <a href="@release.Url" target="_blank" rel="noopener">@release.Title</a>
                        </h3>
                        <div class="timeline-meta">
                            <span><i class="bi bi-tag"></i>@release.Version</span>
                        </div>
                        @if (!string.IsNullOrEmpty(release.Description))
                        {
                            <p class="timeline-summary">@release.Description</p>
                        }
                    </div>
                    <span class="timeline-chip" data-token="@typeToken">@release.Type</span>
                </li>
            }
        </ol>
    }
    else
    {
        <article class="content-card" data-token="comment">
            <h2 class="content-card-title">
                <i class="bi bi-cloud-slash"></i> no_releases
            </h2>
            <p>
                No release notes available. The GitHub API may be rate-limited — try again later.
            </p>
        </article>
    }
</div>
