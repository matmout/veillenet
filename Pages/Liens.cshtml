@page
@model LiensModel
@{
    ViewData["Title"] = "Useful Links";
    ViewData["Description"] = "Curated C# developer resources: official Microsoft docs, AI coding assistants (GitHub Copilot, ChatGPT, Claude), WinForms guides, coding challenges, C# tools, and algorithm practice platforms.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/Liens";
}

@section Styles {
    <link rel="stylesheet" href="~/css/category-cards.css" asp-append-version="true" />
    <style>
        .liens-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: var(--space-4);
        }

        .links-container {
            list-style: none;
            margin: 0;
            padding: 0;
            max-height: 360px;
            overflow-y: auto;
        }

        .link-item {
            display: grid;
            grid-template-columns: 40px 1fr;
            gap: var(--space-3);
            align-items: start;
            padding: var(--space-3) var(--space-4);
            border-bottom: 1px solid var(--border);
            text-decoration: none;
            color: var(--text);
            transition: background var(--motion-fast), color var(--motion-fast);
        }
        .links-container li:last-child .link-item { border-bottom: none; }

        .link-item:hover {
            background: color-mix(in oklab, var(--panel-token, var(--accent)) 8%, transparent);
        }
        .link-item:hover .link-name { color: var(--panel-token, var(--accent)); }
        .link-item:hover .external-icon { opacity: 1; }
        .link-item:hover .link-icon {
            border-color: var(--panel-token, var(--accent));
            color: var(--panel-token, var(--accent));
        }

        .link-icon {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            background: var(--panel-alt);
            color: var(--text-soft);
            transition: border-color var(--motion-fast), color var(--motion-fast);
        }
        .link-icon i { font-size: 1.1rem; }

        .link-content {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
            min-width: 0;
        }

        .link-name {
            font-family: var(--font-ui);
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 0.4rem;
            transition: color var(--motion-fast);
        }

        .link-star { color: var(--token-type); font-size: 0.8rem; }

        .external-icon {
            font-size: 0.7rem;
            color: var(--text-muted);
            opacity: 0;
            transition: opacity var(--motion-fast);
            margin-left: auto;
        }

        .link-description {
            font-size: var(--text-sm);
            color: var(--text-muted);
            line-height: 1.5;
        }

        .category-card .card-header .small {
            color: var(--text-soft);
            font-size: var(--text-sm);
        }
    </style>
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "link-45deg" },
        { "HeaderTitle", "Useful Links" },
        { "HeaderDescription", "Essential resources for C# developers, organised by category." },
        { "HeaderTokenColor", "keyword" }
    })' />

    <div class="liens-grid">
        @foreach (var category in Model.Categories)
        {
            <article class="card category-card">
                <header class="card-header bg-@category.ColorClass">
                    <h2 class="h4 mb-0">
                        <i class="@category.Icon"></i> @category.Name
                    </h2>
                    <p class="small">@category.Description</p>
                </header>
                <div class="card-body p-0">
                    @{
                        var orderedLinks = category.Links
                            .OrderByDescending(l => l.IsRecommended)
                            .ThenBy(l => l.Name)
                            .ToList();
                    }
                    <ul class="links-container">
                        @foreach (var link in orderedLinks)
                        {
                            <li>
                                <a href="@link.Url" target="_blank" rel="noopener" class="link-item">
                                    <span class="link-icon" aria-hidden="true">
                                        <i class="@link.Icon"></i>
                                    </span>
                                    <span class="link-content">
                                        <span class="link-name">
                                            @link.Name
                                            @if (link.IsRecommended)
                                            {
                                                <i class="bi bi-star-fill link-star" title="Recommended"></i>
                                            }
                                            <i class="bi bi-box-arrow-up-right external-icon"></i>
                                        </span>
                                        <span class="link-description">@link.Description</span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>
</div>

