@page
@model LatestLLMModel
@{
    ViewData["Title"] = "Latest LLM Models";
    ViewData["Description"] = "Track recent LLM releases such as GPT-5.5, GPT-5.4, Claude Opus 4.7, Gemini 3.1 Pro, Mistral Medium 3.5, Grok 4.20, Kimi K2.6, and Llama 4.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/LatestLLM";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "cpu" },
        { "HeaderTitle", "Latest LLM Models" },
        { "HeaderDescription", "A curated catalog of recent language models for coding, reasoning, and multimodal development workflows." },
        { "HeaderTokenColor", "type" }
    })' />

    <div class="llm-grid">
        @foreach (var llm in Model.LLMs)
        {
            <article class="content-card llm-card" data-token="type">
                <header class="llm-card-head">
                    <span class="llm-icon-wrapper" aria-hidden="true">
                        <i class="bi bi-robot"></i>
                    </span>
                    <div>
                        <h3 class="llm-name">@llm.Name</h3>
                        <p class="llm-author">
                            <i class="bi bi-building"></i> @llm.Author
                        </p>
                    </div>
                </header>

                <p class="llm-description">@llm.Description</p>

                <dl class="llm-meta">
                    <div>
                        <dt><i class="bi bi-calendar-event"></i> released</dt>
                        <dd>@llm.DateRelease.ToString("dd MMM yyyy")</dd>
                    </div>
                    @if (!string.IsNullOrEmpty(llm.ScoreIA) && llm.ScoreIA != "N/A")
                    {
                        <div>
                            <dt><i class="bi bi-star-fill"></i> score</dt>
                            <dd>@llm.ScoreIA</dd>
                        </div>
                    }
                </dl>

                <div class="content-card-actions">
                    <a class="output-action" href="@llm.Link" target="_blank" rel="noopener">
                        <i class="bi bi-box-arrow-up-right"></i> documentation
                    </a>
                </div>
            </article>
        }
    </div>
</div>

@section Styles {
    <style>
        .llm-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: var(--space-4);
        }

        .llm-card {
            display: flex;
            flex-direction: column;
            gap: var(--space-3);
        }

        .llm-card-head {
            display: grid;
            grid-template-columns: 48px 1fr;
            gap: var(--space-3);
            align-items: start;
        }

        .llm-icon-wrapper {
            width: 48px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius);
            background: color-mix(in oklab, var(--token-type) 16%, transparent);
            border: 1px solid color-mix(in oklab, var(--token-type) 40%, transparent);
            color: var(--token-type);
            font-size: 1.4rem;
        }

        .llm-name {
            margin: 0;
            font-family: var(--font-ui);
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text);
            line-height: 1.25;
        }

        .llm-author {
            margin: 0.2rem 0 0;
            font-family: var(--font-mono);
            font-size: var(--text-xs);
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .llm-description {
            margin: 0;
            color: var(--text-soft);
            font-size: var(--text-sm);
            line-height: 1.6;
            flex: 1;
        }

        .llm-meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
            gap: var(--space-3);
            margin: 0;
            padding: var(--space-3);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--panel-alt);
        }
        .llm-meta > div { display: flex; flex-direction: column; gap: 0.15rem; }
        .llm-meta dt {
            font-family: var(--font-mono);
            font-size: var(--text-xs);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            margin: 0;
        }
        .llm-meta dd {
            margin: 0;
            font-family: var(--font-mono);
            font-size: var(--text-sm);
            color: var(--text);
        }
    </style>
}
