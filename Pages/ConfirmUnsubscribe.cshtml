@page "/Newsletter/ConfirmUnsubscribe"
@model ConfirmUnsubscribeModel
@{
    ViewData["Title"] = "Unsubscribe Confirmation";
    ViewData["Description"] = "Confirmation page for newsletter unsubscription requests on ContainSharp.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/Newsletter/ConfirmUnsubscribe";

    var isSuccess = Model.MessageType == "success";
    var token = isSuccess ? "string" : "preprocessor";
    var icon = isSuccess ? "check-circle" : "x-octagon";
    var heading = isSuccess ? "Unsubscription confirmed" : "Unsubscription failed";
}

<div class="briefing-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", icon },
        { "HeaderTitle", heading },
        { "HeaderDescription", isSuccess
            ? "Your address has been removed from the daily briefing list."
            : "The confirmation link could not be validated." },
        { "HeaderTokenColor", token }
    })' />

    <article class="content-card" data-token="@token">
        <h2 class="content-card-title">
            <i class="bi bi-@icon"></i> @(isSuccess ? "result.ok" : "result.error")
        </h2>
        <p>@Html.Raw(Model.Message)</p>

        <div class="content-card-actions">
            <a class="output-action" asp-page="/Index">
                <i class="bi bi-house"></i> back to dashboard
            </a>
            @if (!isSuccess)
            {
                <a class="output-action" asp-page="/Newsletter">
                    <i class="bi bi-arrow-repeat"></i> try again
                </a>
            }
        </div>
    </article>
</div>
