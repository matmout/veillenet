@page
@model NewsletterArchiveModel
@{
    ViewData["Title"] = "Newsletter Archive";
    ViewData["Description"] = "Archive of all daily newsletters sent by ContainSharp.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/NewsletterArchive";

    var enCulture = new System.Globalization.CultureInfo("en-US");
    var total = Model.Newsletters.Count;
}

<div class="briefing-stage archive-stage">
    <partial name="_PageHeaderPartial" view-data='@(new ViewDataDictionary(ViewData) {
        { "Icon", "archive" },
        { "HeaderTitle", "Newsletter Archive" },
        { "HeaderDescription", "Chronological log of daily briefings published to subscribers." },
        { "HeaderTokenColor", "string" },
        { "HeaderFileSlug", "archive.log" }
    })' />

    @if (Model.Newsletters.Any())
    {
        <div class="archive-toolbar" role="presentation">
            <span class="prompt">$</span>
            <span class="cmd">git log <span class="flag">--graph</span> <span class="flag">--pretty=oneline</span> <span class="arg">-- newsletters/</span></span>
            <span class="spacer"></span>
            <span class="count"><strong>@total</strong> entries</span>
        </div>

        <ol class="commit-log">
            @foreach (var newsletter in Model.Newsletters)
            {
                var hash         = NewsletterArchiveModel.ShortHash(newsletter);
                var refToken     = newsletter.IsSent ? "string" : "type";
                var iso          = newsletter.NewsletterDate.ToString("yyyy-MM-dd", enCulture);
                var fileSlug     = $"newsletter-{iso}.html";
                var previewId    = $"preview-{newsletter.Id}";
                var sentAtLocal  = newsletter.SentAt?.ToLocalTime();
                var createdLocal = newsletter.CreatedAt.ToLocalTime();

                <li class="commit-row" id="row-@newsletter.Id">
                    <span class="commit-gutter" aria-hidden="true"><span class="star"></span></span>
                    <span class="commit-hash">@hash</span>
                    <span class="commit-date">@iso</span>
                    <span class="commit-subject" title="@newsletter.Subject">@newsletter.Subject</span>

                    @if (newsletter.IsSent)
                    {
                        <span class="commit-ref" data-token="@refToken">(HEAD<span class="arrow">→</span>sent)</span>
                    }
                    else
                    {
                        <span class="commit-ref" data-token="@refToken">(pending)</span>
                    }

                    <div class="commit-meta-row">
                        <span class="commit-meta">
                            <span class="comment">//</span>
                            <span><span class="num">@newsletter.SummaryCount</span> <span class="key">summaries</span></span>
                            @if (newsletter.IsSent)
                            {
                                <span class="sep">·</span>
                                <span><span class="num">@newsletter.RecipientCount</span> <span class="key">recipients</span></span>
                                @if (sentAtLocal.HasValue)
                                {
                                    <span class="sep">·</span>
                                    <span><span class="key">sent_at=</span>@sentAtLocal.Value.ToString("HH:mm", enCulture)</span>
                                }
                            }
                            else
                            {
                                <span class="sep">·</span>
                                <span><span class="key">created_at=</span>@createdLocal.ToString("HH:mm", enCulture)</span>
                            }
                        </span>

                        <span class="commit-actions">
                            <button class="editor-tab"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@previewId"
                                    aria-expanded="false"
                                    aria-controls="@previewId">
                                <i class="bi bi-file-earmark-code" aria-hidden="true"></i>
                                <span>@fileSlug.Replace(".html", "")</span><span class="ext">.html</span>
                                <span class="close" aria-hidden="true">×</span>
                            </button>
                        </span>
                    </div>

                    <div class="collapse commit-preview" id="@previewId">
                        <iframe srcdoc="@Html.Raw(newsletter.HtmlContent.Replace("\"", "&quot;"))"
                                title="Newsletter HTML preview"
                                sandbox="allow-same-origin"
                                loading="lazy"></iframe>
                    </div>
                </li>
            }
        </ol>

        <div class="archive-statusbar" role="presentation">
            <span class="branch"><i class="bi bi-git" aria-hidden="true"></i>branch: archive</span>
            <span class="sep">·</span>
            <span class="stat"><span class="num">@total</span> newsletters</span>
            <span class="sep">·</span>
            <span class="stat sent"><span class="num">@Model.SentCount</span> sent</span>
            <span class="sep">·</span>
            <span class="stat pending"><span class="num">@Model.PendingCount</span> pending</span>
            <span class="spacer"></span>
            <span>UTF-8 · LF</span>
        </div>
    }
    else
    {
        <div class="archive-empty" role="status">
            <span><span class="fatal">fatal:</span> no newsletters in archive</span>
            <span class="hint"><span class="prompt">$</span> subscribe to start receiving the daily briefing.</span>
        </div>
    }

    <div class="content-card-actions newsletter-archive-cta">
        <a class="output-action" asp-page="/Newsletter">
            <i class="bi bi-envelope-heart"></i> subscribe
        </a>
        <a class="output-action" asp-page="/Index">
            <i class="bi bi-arrow-left"></i> back to dashboard
        </a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/newsletter-archive.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.commit-row').forEach(function (row) {
                var preview = row.querySelector('.commit-preview');
                if (!preview) return;
                preview.addEventListener('shown.bs.collapse', function () { row.classList.add('is-open'); });
                preview.addEventListener('hidden.bs.collapse', function () { row.classList.remove('is-open'); });
            });
        })();
    </script>
}
