@page
@model IndexModel
@using VeilleNet.Models.ViewModels
@using VeilleNet.Models
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Description"] = "ContainSharp Dashboard - Your daily C# news hub. Track latest .NET releases, AI coding tools, WinForms updates, official blogs, GitHub trending projects and C# video tutorials.";
    ViewData["CanonicalUrl"] = "https://containsharp.com/";

    var todayLabel = DateTime.UtcNow.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("en-US")).ToLowerInvariant();
}

<h1 class="visually-hidden">Daily C# Briefing — @todayLabel</h1>

<div class="briefing-stage">
    <!-- Hero: Output Window — the lede -->
    <section class="briefing-hero" aria-label="Today in 60 seconds">
        <div class="card vs-output">
            <div class="output-titlebar">
                <div class="controls">
                    <span class="dot close"></span>
                    <span class="dot min"></span>
                    <span class="dot max"></span>
                </div>
                <div class="title">today_in_60_seconds.log</div>
                <div class="spacer"></div>
                <span class="output-meta tabular-nums">@todayLabel</span>
            </div>
            <div class="output-toolbar">
                <div class="chip">Show output from: AI Daily Briefing</div>
                <div class="chip">Encoding: UTF-8</div>
                <div class="spacer"></div>
                <button type="button" class="output-action" data-action="reload" title="Reload briefing">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> reload
                </button>
                <a class="output-action" asp-page="/History" title="History">
                    <i class="bi bi-clock-history" aria-hidden="true"></i> history
                </a>
            </div>
            <div id="output-stream" class="output-stream" aria-live="polite"></div>
        </div>
    </section>

    <!-- Row 1: AI agents (wide) + C# videos (narrow) -->
    <section class="briefing-row briefing-row-8-4">
        <div>
            @await Html.PartialAsync("_NewsBlockPartial", new NewsBlockViewModel
            {
                Title = "coding_agents.news",
                Icon = "bi-robot",
                TokenColor = "type",
                DefaultImageUrl = "/images/newsia.png",
                ShowAuthor = false,
                LoadingText = "Loading AI news...",
                EmptyStateTitle = "No AI news right now",
                EmptyStateMessage = "Check back soon for the latest AI coding tool updates.",
                Items = Model.AINews.ToBlockItems()
            })
        </div>
        <div>
            @await Html.PartialAsync("_NewsBlockPartial", new NewsBlockViewModel
            {
                Title = "videos.csharp",
                Icon = "bi-play-circle",
                TokenColor = "function",
                DefaultImageUrl = "/images/videoGeneric.png",
                ShowAuthor = true,
                AuthorIcon = "bi-camera-video",
                ShowSource = false,
                ShowAiSummary = false,
                SanitizeHtml = false,
                SummaryMaxLength = 200,
                ImageWidth = 120,
                ImageHeight = 90,
                LoadingText = "Loading videos...",
                EmptyStateTitle = "No videos right now",
                EmptyStateMessage = "Check back soon for new C# video content.",
                Items = Model.Videos.ToBlockItems()
            })
        </div>
    </section>

    @if (Model.IsRedditEnabled)
    {
        <!-- Row 2 (optional): Reddit full width -->
        <section class="briefing-row briefing-row-12">
            <div>
                @await Html.PartialAsync("_NewsBlockPartial", new NewsBlockViewModel
                {
                    Title = "reddit.r_csharp_dotnet",
                    Icon = "bi-reddit",
                    TokenColor = "preprocessor",
                    ShowTitle = true,
                    ShowAuthor = true,
                    ShowSource = true,
                    ShowAiSummary = false,
                    SanitizeHtml = false,
                    DateFormat = "dd MMM yyyy HH:mm",
                    ColumnsPerRow = 2,
                    LoadingText = "Loading Reddit posts...",
                    Items = Model.RedditPosts.ToBlockItems()
                })
            </div>
        </section>
    }

    <!-- Row 3: Official blogs (wide) + WinForms (narrow) -->
    <section class="briefing-row briefing-row-7-5">
        <div>
            @await Html.PartialAsync("_NewsBlockPartial", new NewsBlockViewModel
            {
                Title = "official_dotnet.blogs",
                Icon = "bi-rss",
                TokenColor = "string",
                DefaultIconClass = "bi-newspaper",
                ShowAuthor = true,
                LoadingText = "Loading posts...",
                EmptyStateTitle = "No posts right now",
                EmptyStateMessage = "Check back soon for the latest .NET blog posts.",
                Items = Model.BlogPosts.ToBlockItems()
            })
        </div>
        <div>
            @await Html.PartialAsync("_NewsBlockPartial", new NewsBlockViewModel
            {
                Title = "devexpress.winforms",
                Icon = "bi-window-desktop",
                TokenColor = "number",
                DefaultIconClass = "bi-newspaper",
                ShowAuthor = false,
                SummaryMaxLength = 260,
                LoadingText = "Loading WinForms news...",
                EmptyStateTitle = "No WinForms news right now",
                EmptyStateMessage = "Check back soon for the latest DevExpress WinForms updates.",
                Items = Model.WinFormNews.ToBlockItems()
            })
        </div>
    </section>

    <!-- Row 4: StackOverflow (narrow) + GitHub Trending (wide) -->
    <section class="briefing-row briefing-row-5-7">
        <div>
            @await Html.PartialAsync("_NewsBlockPartial", new NewsBlockViewModel
            {
                Title = "stackoverflow.questions",
                HeaderIconHtml = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" fill=\"currentColor\" viewBox=\"0 0 16 16\" style=\"vertical-align: -0.125em;\"><path d=\"M12.412 14.572V10.29h1.428V16H1v-5.71h1.428v4.282z\"/><path d=\"M3.857 13.145h7.137v-1.428H3.857zM10.254 0 9.108.852l4.26 5.727 1.146-.852zm-3.54 3.377 5.484 4.567.913-1.097L7.627 2.28l-.914 1.097zM4.922 6.55l6.47 3.013.603-1.294-6.47-3.013zm-.925 3.344 6.985 1.469.294-1.398-6.985-1.468z\"/></svg>",
                TokenColor = "attribute",
                ShowAuthor = true,
                ShowSource = false,
                ShowAiSummary = false,
                SanitizeHtml = false,
                SummaryMaxLength = 200,
                ShowTags = true,
                MaxHeight = 600,
                LoadingText = "Loading StackOverflow questions...",
                EmptyStateTitle = "No questions right now",
                EmptyStateMessage = "Check back soon for the latest StackOverflow activity.",
                Items = Model.StackOverflowQuestions.ToBlockItems()
            })
        </div>
        <div>
            @await Html.PartialAsync("_NewsBlockPartial", new NewsBlockViewModel
            {
                Title = "github.trending_csharp",
                Icon = "bi-github",
                TokenColor = "function",
                ShowStats = true,
                ShowAiSummary = false,
                SanitizeHtml = false,
                MaxHeight = 600,
                LoadingText = "Loading projects...",
                EmptyStateTitle = "No trending projects right now",
                EmptyStateMessage = "Check back soon for trending C# repos on GitHub.",
                Items = Model.TrendingProjects.ToBlockItems()
            })
        </div>
    </section>

    <!-- Inline newsletter CTA — thin, single line, no gradient card -->
    <section class="briefing-cta" aria-label="Newsletter subscription">
        <div class="briefing-cta-text">
            <span class="briefing-cta-prompt">~ subscribe</span>
            <span>Receive this briefing in your inbox every morning.</span>
        </div>
        <form method="post" asp-page-handler="QuickSubscribe" class="briefing-cta-form">
            <label for="newsletter-email" class="visually-hidden">Email address</label>
            <input id="newsletter-email"
                   type="email"
                   class="briefing-cta-input"
                   name="Email"
                   placeholder="you@domain.tld"
                   required />
            <button type="submit" class="briefing-cta-submit">
                Subscribe <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </form>
        <span class="briefing-cta-meta tabular-nums">
            @Model.ActiveNewsletterSubscribersCount.ToString("N0") subscribers
        </span>
    </section>

    @if (!string.IsNullOrEmpty(ViewData["NewsletterMessage"] as string))
    {
        var messageType = ViewData["NewsletterMessageType"] as string ?? "info";
        var alertClass = messageType switch
        {
            "success" => "vs-alert-success",
            "error" => "vs-alert-error",
            "info" => "vs-alert-info",
            _ => "vs-alert-secondary"
        };

        <div class="vs-alert @alertClass" role="alert">
            @ViewData["NewsletterMessage"]
        </div>
    }
</div>

@section Scripts {
    <script>
        window.__dailyBriefing = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyBriefing ?? ""));
    </script>
}
