{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSettings": {
    "SourceEmail": "${AWS_SENDER}",
    "AwsAccessKey": "${AWS_ACCESS_KEY}",
    "AwsSecretKey": "${AWS_SECRET_KEY}",
    "AwsRegion": "eu-west-3"
  },
  "AWS": {
    "Region": "eu-west-3",
    "Profile": "default"
  }
}
