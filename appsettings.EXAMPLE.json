{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "REPLACE_WITH_YOUR_DATABASE_CONNECTION_STRING",
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 30
  },
  "Mistral": {
    "ApiKey": "REPLACE_WITH_YOUR_MISTRAL_API_KEY",
    "Endpoint": "https://api.mistral.ai/v1/",
    "Model": "mistral-small-latest",
    "CacheMinutes": 1440,
    "MaxInputChars": 12000,
    "Temperature": 0.2
  },
  "EmailSettings": {
    "SourceEmail": "REPLACE_WITH_YOUR_SOURCE_EMAIL",
    "AwsAccessKey": "REPLACE_WITH_YOUR_AWS_ACCESS_KEY",
    "AwsSecretKey": "REPLACE_WITH_YOUR_AWS_SECRET_KEY",
    "AwsRegion": "eu-west-3"
  },
  "Reddit": {
    "Enabled": false,
    "CacheMinutes": 60,
    "PostsPerSubreddit": 10
  }
}
